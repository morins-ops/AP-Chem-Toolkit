      ctx.fillText(s.name, x + w/2, 25);



      // Draw molecule particles with IMF lines

      const numParticles = 8;

      const particles = [];

      for (let i = 0; i < numParticles; i++) {

        const px = x + 30 + (i % 4) * ((w-60)/3);

        const py = 50 + Math.floor(i/4) * 60 + (i%2)*15;

        particles.push({x:px, y:py});

        // Draw molecule

        ctx.beginPath();

        ctx.arc(px, py, 12 + s.ldfStr, 0, Math.PI*2);

        ctx.fillStyle = s.color + '44';

        ctx.fill();

        ctx.strokeStyle = s.color;

        ctx.lineWidth = 1.5;

        ctx.stroke();

      }



      // Draw IMF connections between nearby particles

      for (let i = 0; i < particles.length; i++) {

        for (let j = i+1; j < particles.length; j++) {

          const dx = particles[j].x - particles[i].x;

          const dy = particles[j].y - particles[i].y;

          const dist = Math.sqrt(dx*dx+dy*dy);

          if (dist < 90) {

            ctx.beginPath();

            ctx.setLineDash(s.imfs.includes('H-Bonding') ? [] : [4,4]);

            ctx.moveTo(particles[i].x, particles[i].y);

            ctx.lineTo(particles[j].x, particles[j].y);

            ctx.strokeStyle = s.imfs.includes('H-Bonding') ? '#ff6666' :

                             s.imfs.includes('Dipole-Dipole') ? '#ffaa44' : '#666';

            ctx.lineWidth = s.imfs.includes('H-Bonding') ? 2.5 :

                           s.imfs.includes('Dipole-Dipole') ? 1.8 : 1;

            ctx.stroke();

            ctx.setLineDash([]);

          }

        }

      }



      // IMF strength bars

      const barY = 195;

      const imfTypes = ['LDF','Dipole-Dipole','H-Bonding'];

      const imfColors = ['#8888aa','#ffaa44','#ff6666'];

      const imfLabels = ['London\nDispersion','Dipole-\nDipole','Hydrogen\nBonding'];



      imfTypes.forEach((type, ti) => {

        const barX = x + 15 + ti * (w/3);

        const barW = w/3 - 20;

        const present = s.imfs.includes(type);

        const strength = !present ? 0 : type === 'LDF' ? s.ldfStr/6 : type === 'Dipole-Dipole' ? 0.5 : 0.8;

        const barH = strength * 80;



        // Bar background

        ctx.fillStyle = '#333';

        ctx.fillRect(barX, barY + 80 - 80, barW, 80);

        // Bar fill

        if (present) {

          ctx.fillStyle = imfColors[ti] + '88';

          ctx.fillRect(barX, barY + 80 - barH, barW, barH);

          ctx.strokeStyle = imfColors[ti];

          ctx.lineWidth = 1;

          ctx.strokeRect(barX, barY + 80 - barH, barW, barH);

        }

        // Label

        ctx.fillStyle = present ? imfColors[ti] : '#555';

        ctx.font = '9px Roboto';

        ctx.textAlign = 'center';

        const lines = imfLabels[ti].split('\n');

        lines.forEach((line, li) => {

          ctx.fillText(line, barX + barW/2, barY + 95 + li*11);

        });

        if (!present) {

          ctx.fillText('✗', barX + barW/2, barY + 40);

        }

      });



      // Boiling point indicator

      ctx.fillStyle = _tc('#ddd','#333'); ctx.font = '11px Roboto'; ctx.textAlign = 'center';

      ctx.fillText(`BP: ${s.bp}°C`, x + w/2, H - 20);



      // BP bar

      const bpNorm = (s.bp + 260) / 400; // normalize -260 to 140

      const bpBarW = bpNorm * (w - 30);

      ctx.fillStyle = '#333'; ctx.fillRect(x+15, H-15, w-30, 8);

      ctx.fillStyle = s.color; ctx.fillRect(x+15, H-15, bpBarW, 8);

    };



    drawSubstance(s1, 0, W/2 - 5);

    drawSubstance(s2, W/2 + 5, W/2 - 5);



    // Divider

    ctx.strokeStyle = 'var(--gold-dark)'; ctx.lineWidth = 1;

    ctx.setLineDash([4,4]);

    ctx.beginPath(); ctx.moveTo(W/2, 10); ctx.lineTo(W/2, H-5); ctx.stroke();

    ctx.setLineDash([]);

  },

  init() { this.update(); }

};



const U3B = {

  showParticles: true,

  particles: [],

  animId: null,

  R: 0.08206,

  update() {

    const lock = document.getElementById('u3b-lock').value;

    let P = +document.getElementById('u3b-pressure').value;

    let V = +document.getElementById('u3b-volume').value;

    let T = +document.getElementById('u3b-temp').value;

    const n = +document.getElementById('u3b-moles').value;

    const real = document.getElementById('u3b-real').checked;



    // van der Waals constants for generic gas (similar to N₂)

    const a = 1.390, b = 0.03913;



    if (lock === 'V') {

      V = real ? this.solveVreal(P, n, T, a, b) : (n * this.R * T) / P;

      document.getElementById('u3b-volume').value = V;

    } else if (lock === 'P') {

      P = real ? (n*this.R*T)/(V-n*b) - a*(n*n)/(V*V) : (n * this.R * T) / V;

      document.getElementById('u3b-pressure').value = Math.max(0.2, Math.min(5, P));

    } else if (lock === 'T') {

      T = real ? ((P + a*n*n/(V*V)) * (V - n*b)) / (n*this.R) : (P * V) / (n * this.R);

      document.getElementById('u3b-temp').value = Math.max(100, Math.min(800, Math.round(T)));

    }



    P = +document.getElementById('u3b-pressure').value;

    V = +document.getElementById('u3b-volume').value;

    T = +document.getElementById('u3b-temp').value;



    document.getElementById('u3b-p-val').textContent = P.toFixed(2);

    document.getElementById('u3b-v-val').textContent = V.toFixed(1);

    document.getElementById('u3b-t-val').textContent = Math.round(T);

    document.getElementById('u3b-n-val').textContent = n.toFixed(2);



    const idealV = (n * this.R * T) / P;

    const calc = document.getElementById('u3b-calc');

    calc.innerHTML = `<strong>PV = nRT</strong><br>

      (${P.toFixed(2)})(${V.toFixed(1)}) = (${n.toFixed(2)})(0.08206)(${Math.round(T)})<br>

      PV = <span style="color:var(--gold)">${(P*V).toFixed(2)}</span> &nbsp; nRT = <span style="color:var(--gold)">${(n*this.R*T).toFixed(2)}</span>

      ${real ? `<br><br><strong>Van der Waals:</strong><br>[P + a(n/V)²](V - nb) = nRT<br>Ideal V = ${idealV.toFixed(1)} L | Real V = ${V.toFixed(1)} L` : ''}`;



    this.setupParticles(n, T, V);

    this.draw();

  },

  solveVreal(P, n, T, a, b) {

    // Iterative solver for real gas volume

    let V = (n * this.R * T) / P; // ideal guess

    for (let i = 0; i < 20; i++) {

      const Pcalc = (n*this.R*T)/(V-n*b) - a*n*n/(V*V);

      const dP = Pcalc - P;

      V += dP * 0.1;

      if (V < n*b*1.1) V = n*b*1.1;

    }

    return Math.max(2, Math.min(60, V));

  },

  setupParticles(n, T, V) {

    const count = Math.round(n * 15);

    const speed = Math.sqrt(T / 273) * 2;

    while (this.particles.length < count) {

      this.particles.push({ x: Math.random()*0.8+0.1, y: Math.random()*0.8+0.1,

        vx: (Math.random()-0.5)*speed, vy: (Math.random()-0.5)*speed });

    }

    while (this.particles.length > count) this.particles.pop();

    // Update speeds

    this.particles.forEach(p => {

      const mag = Math.sqrt(p.vx*p.vx + p.vy*p.vy) || 1;

      p.vx = (p.vx/mag) * speed * (0.5 + Math.random());

      p.vy = (p.vy/mag) * speed * (0.5 + Math.random());

    });

  },

  draw() {

    const c = document.getElementById('u3b-canvas');

    const ctx = c.getContext('2d');

    const W = c.width, H = c.height;

    ctx.clearRect(0,0,W,H);



    if (this.showParticles) {

      this.drawParticleView(ctx, W, H);

    } else {

      this.drawSpeedDist(ctx, W, H);

    }

  },

  drawParticleView(ctx, W, H) {

    const V = +document.getElementById('u3b-volume').value;

    const T = +document.getElementById('u3b-temp').value;

    // Container size proportional to volume

    const maxDim = Math.min(W-40, H-60);

    const scale = Math.sqrt(V / 60);

    const cW = maxDim * scale * 0.9;

    const cH = maxDim * scale * 0.7;

    const cx = (W - cW) / 2;

    const cy = 30 + (H - 60 - cH) / 2;



    // Draw container

    ctx.strokeStyle = _tg(); ctx.lineWidth = 3;

    ctx.strokeRect(cx, cy, cW, cH);



    // Piston on top

    ctx.fillStyle = '#555'; ctx.fillRect(cx, cy-10, cW, 12);

    ctx.fillStyle = '#777'; ctx.fillRect(cx + cW/2 - 5, cy-25, 10, 20);



    // Labels

    ctx.fillStyle = _tc('#aaa','#666'); ctx.font = '11px Roboto'; ctx.textAlign = 'center';

    ctx.fillText(`V = ${V.toFixed(1)} L`, W/2, cy + cH + 20);

    ctx.fillText(`T = ${Math.round(T)} K`, W/2, cy + cH + 35);



    // Draw particles

    const speed = Math.sqrt(T / 273) * 2;

    this.particles.forEach(p => {

      p.x += p.vx * 0.008;

      p.y += p.vy * 0.008;

      if (p.x < 0.05 || p.x > 0.95) { p.vx *= -1; p.x = Math.max(0.05, Math.min(0.95, p.x)); }

      if (p.y < 0.05 || p.y > 0.95) { p.vy *= -1; p.y = Math.max(0.05, Math.min(0.95, p.y)); }



      const px = cx + p.x * cW;

      const py = cy + p.y * cH;

      const sp = Math.sqrt(p.vx*p.vx + p.vy*p.vy);

      const hue = Math.min(60, sp * 15); // blue=cold, yellow/red=hot

      ctx.beginPath();

      ctx.arc(px, py, 5, 0, Math.PI*2);

      ctx.fillStyle = `hsl(${200-hue*3}, 80%, 60%)`;

      ctx.fill();

    });



    if (this.animId) cancelAnimationFrame(this.animId);

    this.animId = requestAnimationFrame(() => this.draw());

  },

  drawSpeedDist(ctx, W, H) {

    const T = +document.getElementById('u3b-temp').value;

    const m = 0.028; // kg/mol (N₂-like)

    const R = 8.314;

    const pad = {l:60, r:20, t:30, b:45};

    const gW = W-pad.l-pad.r, gH = H-pad.t-pad.b;



    // Maxwell-Boltzmann distribution

    const maxV = 1500;

    const temps = [T];

    if (T > 200) temps.push(T * 0.5);

    if (T < 700) temps.push(T * 2);

    temps.sort((a,b) => a-b);



    const colors = ['#5DADE2',_tg(),'#E74C3C'];



    // Find max f for scaling

    let maxF = 0;

    temps.forEach(temp => {

      for (let v = 0; v <= maxV; v += 10) {

        const f = 4*Math.PI * Math.pow(m/(2*Math.PI*R*temp), 1.5) * v*v * Math.exp(-m*v*v/(2*R*temp));

        if (f > maxF) maxF = f;

      }

    });



    // Axes

    ctx.strokeStyle = '#666'; ctx.lineWidth = 1;

    ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, H-pad.b); ctx.lineTo(W-pad.r, H-pad.b); ctx.stroke();



    // Grid lines

    ctx.strokeStyle = '#333'; ctx.lineWidth = 0.5;

    for (let i = 1; i <= 4; i++) {

      const y = H-pad.b - (i/4)*gH;

      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W-pad.r, y); ctx.stroke();

    }



    // Draw curves

    temps.forEach((temp, ti) => {

      const isMain = temp === T;

      ctx.beginPath();

      ctx.strokeStyle = colors[ti % colors.length];

      ctx.lineWidth = isMain ? 3 : 1.5;

      if (!isMain) ctx.setLineDash([5,5]);



      for (let v = 0; v <= maxV; v += 5) {

        const f = 4*Math.PI * Math.pow(m/(2*Math.PI*R*temp), 1.5) * v*v * Math.exp(-m*v*v/(2*R*temp));

        const x = pad.l + (v/maxV) * gW;

        const y = H - pad.b - (f/maxF) * gH * 0.9;

        if (v === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);

      }

      ctx.stroke();

      ctx.setLineDash([]);



      // Label

      ctx.fillStyle = colors[ti % colors.length];

      ctx.font = isMain ? 'bold 11px Roboto' : '10px Roboto';

      ctx.textAlign = 'left';

      const labelV = Math.sqrt(2*R*temp/m);

      const lx = pad.l + (labelV/maxV)*gW + 10;

      const lf = 4*Math.PI * Math.pow(m/(2*Math.PI*R*temp), 1.5) * labelV*labelV * Math.exp(-m*labelV*labelV/(2*R*temp));

      const ly = H - pad.b - (lf/maxF)*gH*0.9 - 5;

      ctx.fillText(`${Math.round(temp)} K`, Math.min(lx, W-60), Math.max(ly, 20));

    });



    // X axis labels

    ctx.fillStyle = _tc('#aaa','#666'); ctx.font = '10px Roboto'; ctx.textAlign = 'center';

    for (let v = 0; v <= maxV; v += 300) {

      const x = pad.l + (v/maxV)*gW;

      ctx.fillText(v.toString(), x, H-pad.b+15);

    }

    ctx.fillText('Molecular Speed (m/s)', pad.l + gW/2, H-5);



    // Y axis label

    ctx.save(); ctx.translate(15, pad.t + gH/2); ctx.rotate(-Math.PI/2);

    ctx.fillStyle = _tc('#aaa','#666'); ctx.font = '10px Roboto'; ctx.textAlign = 'center';

    ctx.fillText('Fraction of Molecules', 0, 0); ctx.restore();



    // Title

    ctx.fillStyle = _tg(); ctx.font = 'bold 13px Roboto'; ctx.textAlign = 'center';

    ctx.fillText('Maxwell-Boltzmann Speed Distribution', W/2, 18);



    if (this.animId) cancelAnimationFrame(this.animId);

    this.animId = null;

  },

  toggleView() {

    this.showParticles = !this.showParticles;

    if (this.animId) { cancelAnimationFrame(this.animId); this.animId = null; }

    this.draw();

  },

  init() {

    this.particles = [];

    this.update();

  }

};



const U3C = {

  // Solubility data: [temp(°C), solubility(g/100g H₂O)] for each solute

  solutes: [

    { name:'KNO₃', color:_tg(), data:[[0,13],[10,21],[20,32],[30,46],[40,64],[50,86],[60,110],[70,138],[80,169],[90,202],[100,246]] },

    { name:'NaCl', color:'#5DADE2', data:[[0,35.7],[10,35.8],[20,36],[30,36.3],[40,36.6],[50,37],[60,37.3],[70,37.8],[80,38.4],[90,39],[100,39.8]] },

    { name:'KCl', color:'#4CAF50', data:[[0,28],[10,31],[20,34],[30,37],[40,40],[50,43],[60,45.5],[70,48.3],[80,51.1],[90,54],[100,56.7]] },

    { name:'NaNO₃', color:'#E74C3C', data:[[0,73],[10,80],[20,88],[30,96],[40,104],[50,114],[60,124],[70,134],[80,148],[90,163],[100,180]] },

    { name:'Ce₂(SO₄)₃', color:'#9B59B6', data:[[0,21],[10,17],[20,13],[30,10],[40,8],[50,6.5],[60,5.5],[70,4.5],[80,4],[90,3.5],[100,3]] },

    { name:'KClO₃', color:'#FF9800', data:[[0,3.3],[10,5],[20,7.4],[30,10.5],[40,14],[50,19.3],[60,24],[70,30.2],[80,38.5],[90,48],[100,57]] }

  ],

  getSolubility(soluteIdx, temp) {

    const data = this.solutes[soluteIdx].data;

    // Linear interpolation

    for (let i = 0; i < data.length - 1; i++) {

      if (temp >= data[i][0] && temp <= data[i+1][0]) {

        const t = (temp - data[i][0]) / (data[i+1][0] - data[i][0]);

        return data[i][1] + t * (data[i+1][1] - data[i][1]);

      }

    }

    return data[data.length-1][1];

  },

  update() {

    const sIdx = +document.getElementById('u3c-solute').value;

    const temp = +document.getElementById('u3c-temp').value;

    const mass = +document.getElementById('u3c-mass').value;

    document.getElementById('u3c-t-val').textContent = temp;

    document.getElementById('u3c-mass-val').textContent = mass;



    const solubility = this.getSolubility(sIdx, temp);

    const saturated = mass >= solubility;

    const dissolved = Math.min(mass, solubility);

    const precipitate = Math.max(0, mass - solubility);



    const status = document.getElementById('u3c-status');

    status.innerHTML = `<strong>${this.solutes[sIdx].name}</strong> at ${temp}°C<br>

      Solubility: <span style="color:var(--gold)">${solubility.toFixed(1)} g / 100g H₂O</span><br>

      Added: ${mass} g<br>

      Dissolved: ${dissolved.toFixed(1)} g<br>

      ${saturated ? `<span style="color:var(--error)">Precipitate: ${precipitate.toFixed(1)} g (supersaturated!)</span>` :

        `<span style="color:var(--success)">Unsaturated — can dissolve ${(solubility - mass).toFixed(1)} more g</span>`}`;



    this.draw(sIdx, temp, mass);

  },

  draw(sIdx, temp, mass) {

    const c = document.getElementById('u3c-canvas');

    const ctx = c.getContext('2d');

    const W = c.width, H = c.height;

    ctx.clearRect(0,0,W,H);

    ctx.fillStyle = '#fff'; ctx.fillRect(0,0,W,H);



    const pad = {l:55, r:20, t:30, b:40};

    const gW = W-pad.l-pad.r, gH = H-pad.t-pad.b;



    // Draw grid

    ctx.strokeStyle = '#ddd'; ctx.lineWidth = 0.5;

    for (let t = 0; t <= 100; t += 20) {

      const x = pad.l + (t/100)*gW;

      ctx.beginPath(); ctx.moveTo(x, pad.t); ctx.lineTo(x, H-pad.b); ctx.stroke();

    }

    for (let s = 0; s <= 250; s += 50) {

      const y = H - pad.b - (s/250)*gH;

      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W-pad.r, y); ctx.stroke();

    }



    // Axes

    ctx.strokeStyle = '#333'; ctx.lineWidth = 1.5;

    ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, H-pad.b); ctx.lineTo(W-pad.r, H-pad.b); ctx.stroke();



    // Draw ALL solubility curves (faded)

    this.solutes.forEach((sol, si) => {

      const isSelected = si === sIdx;

      ctx.beginPath();

      ctx.strokeStyle = isSelected ? sol.color : sol.color + '44';

      ctx.lineWidth = isSelected ? 3 : 1;



      sol.data.forEach(([t, s], di) => {

        const x = pad.l + (t/100)*gW;

        const y = H - pad.b - (s/250)*gH;

        if (di === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);

      });

      ctx.stroke();



      // Label at end

      const last = sol.data[sol.data.length - 1];

      ctx.fillStyle = isSelected ? sol.color : sol.color + '66';

      ctx.font = isSelected ? 'bold 11px Roboto' : '9px Roboto';

      ctx.textAlign = 'left';

      const ly = H - pad.b - (last[1]/250)*gH;

      ctx.fillText(sol.name, W-pad.r+3, Math.max(ly, 15));

    });



    // Draw current point

    const solubility = this.getSolubility(sIdx, temp);

    const px = pad.l + (temp/100)*gW;

    const py = H - pad.b - (solubility/250)*gH;



    // Current mass horizontal line

    const my = H - pad.b - (Math.min(mass,250)/250)*gH;

    ctx.setLineDash([4,4]);

    ctx.strokeStyle = mass > solubility ? '#E74C3C' : '#4CAF50';

    ctx.lineWidth = 1.5;

    ctx.beginPath(); ctx.moveTo(pad.l, my); ctx.lineTo(W-pad.r, my); ctx.stroke();

    ctx.setLineDash([]);



    // Temperature vertical line

    ctx.setLineDash([4,4]); ctx.strokeStyle = '#888'; ctx.lineWidth = 1;

    ctx.beginPath(); ctx.moveTo(px, pad.t); ctx.lineTo(px, H-pad.b); ctx.stroke();

    ctx.setLineDash([]);



    // Solubility point

    ctx.beginPath(); ctx.arc(px, py, 7, 0, Math.PI*2);

    ctx.fillStyle = this.solutes[sIdx].color;

    ctx.fill();

    ctx.strokeStyle = '#333'; ctx.lineWidth = 2; ctx.stroke();



    // Axis labels

    ctx.fillStyle = '#333'; ctx.font = '11px Roboto'; ctx.textAlign = 'center';

    for (let t = 0; t <= 100; t += 20) {

      ctx.fillText(t + '°C', pad.l + (t/100)*gW, H-pad.b+15);

    }

    ctx.fillText('Temperature (°C)', pad.l + gW/2, H-5);



    ctx.textAlign = 'right';

    for (let s = 0; s <= 250; s += 50) {

      const y = H - pad.b - (s/250)*gH;

      ctx.fillText(s.toString(), pad.l-8, y+4);

    }

    ctx.save(); ctx.translate(12, pad.t+gH/2); ctx.rotate(-Math.PI/2);

    ctx.textAlign = 'center'; ctx.fillText('Solubility (g/100g H₂O)', 0, 0); ctx.restore();



    // Title

    ctx.fillStyle = '#222'; ctx.font = 'bold 13px Roboto'; ctx.textAlign = 'center';

    ctx.fillText('Solubility Curves', W/2, 18);



    // Region labels

    ctx.font = '10px Roboto'; ctx.fillStyle = '#666';

    if (mass <= solubility) {

      ctx.fillText('UNSATURATED', px, Math.max(my - 10, pad.t + 15));

    } else {

      ctx.fillStyle = '#c0392b';

      ctx.fillText('EXCESS SOLID', px, Math.min(my + 15, H - pad.b - 5));

    }

  },

  init() { this.update(); }

};



const U3D = {

  colorMap: {

    blue: { rgb:'0,100,200', absorbed:'orange/red', lambda:620 },

    purple: { rgb:'120,0,160', absorbed:'green/yellow', lambda:525 },

    green: { rgb:'0,140,60', absorbed:'red', lambda:640 },

