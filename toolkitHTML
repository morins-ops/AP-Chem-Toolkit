      ctx.beginPath(); ctx.arc(ix, iy, 8, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = _tc('#ffffff','#1A1410'); ctx.font = 'bold 12px Roboto'; ctx.textAlign = 'center';
      ctx.fillText(s.cathode.ion, ix, iy + 20);
    }

    // Cathode electrode mass label (on the electrode itself, near top)
    ctx.fillStyle = _tc('#ddd','#333'); ctx.font = '9px Roboto'; ctx.textAlign = 'center';
