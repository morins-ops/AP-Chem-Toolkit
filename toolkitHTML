    // Pair 2: base <-> conj acid (right side)
    ctx.strokeStyle = '#5DADE2'; ctx.lineWidth = 1; ctx.setLineDash([3,3]);
    ctx.beginPath();
    ctx.moveTo(baseX + 45, baseY); ctx.lineTo(baseX + 55, baseY);
    ctx.lineTo(baseX + 55, caY); ctx.lineTo(caX + 45, caY);
    ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = '#5DADE2'; ctx.font = '8px Roboto'; ctx.textAlign = 'center';
    ctx.save(); ctx.translate(baseX + 65, (baseY + caY)/2);
    ctx.rotate(Math.PI/2); ctx.fillText('Pair 2', 0, 0);
    ctx.restore();

    // Down arrows from reactants to products
    ctx.strokeStyle = 'rgba(255,255,255,0.3)'; ctx.lineWidth = 1.5; ctx.setLineDash([]);
