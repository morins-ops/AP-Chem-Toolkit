    ctx.font = '9px Roboto'; ctx.fillStyle = '#E74C3C';
    ctx.fillText('Conjugate Base', cbX, cbY + 20);

    // Conjugate acid (right - from base)
    const caX = W*0.72, caY = 255;
    ctx.beginPath(); ctx.arc(caX, caY, rad, 0, Math.PI*2);
    ctx.fillStyle = 'rgba(93,173,226,0.08)'; ctx.fill();
    ctx.strokeStyle = '#5DADE2'; ctx.lineWidth = 1.5;
    ctx.setLineDash([4,3]); ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = '#fff'; ctx.font = 'bold 13px Roboto';
    ctx.fillText(r.conjugatePairs[1].acid, caX, caY + 4);
    ctx.font = '9px Roboto'; ctx.fillStyle = '#5DADE2';
    ctx.fillText('Conjugate Acid', caX, caY + 20);

    // Conjugate pair brackets
    // Pair 1: acid <-> conj base (left side)
    ctx.strokeStyle = '#E74C3C'; ctx.lineWidth = 1; ctx.setLineDash([3,3]);
    ctx.beginPath();
    ctx.moveTo(acidX - 45, acidY); ctx.lineTo(acidX - 55, acidY);
    ctx.lineTo(acidX - 55, cbY); ctx.lineTo(cbX - 45, cbY);
    ctx.stroke(); ctx.setLineDash([]);
    ctx.fillStyle = '#E74C3C'; ctx.font = '8px Roboto'; ctx.textAlign = 'center';
    ctx.save(); ctx.translate(acidX - 65, (acidY + cbY)/2);
