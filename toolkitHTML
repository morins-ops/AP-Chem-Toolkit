function initUnit0() {
  const grid = document.getElementById('u0-unit-cards');
  if (!grid) return;
  grid.innerHTML = '';
  for (let i = 1; i <= 10; i++) {
    const u = UNITS[i];
    if (!u) continue;
    const card = document.createElement('div');
    card.className = 'overview-unit-card';
    card.onclick = () => switchUnit(i);
    const isExamTab = (i === 10);
    card.innerHTML =
      `<div class="ouc-number">${isExamTab ? '\uD83D\uDCDD' : 'Unit ' + i}</div>` +
      `<div class="ouc-name">${u.name}</div>` +
      (u.weight ? `<div class="ouc-weight">${u.weight} of AP Exam</div>` : '') +
      `<div class="ouc-subtabs">${u.subtabs.map(s => `<span class="ouc-tag">${s.label}</span>`).join('')}</div>` +
      `<div class="ouc-tools">${u.subtabs.length} ${isExamTab ? 'resource' : 'interactive tool'}${u.subtabs.length > 1 ? 's' : ''}</div>`;
    grid.appendChild(card);
  }
}

