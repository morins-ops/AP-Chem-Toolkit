    if (particles === 0) {
      document.getElementById('u1a-disp-particles').textContent = '0';
    } else {
      const exp = Math.floor(Math.log10(particles));
      const coeff = particles / Math.pow(10, exp);
      document.getElementById('u1a-disp-particles').innerHTML = `${coeff.toFixed(3)} &times; 10<sup>${exp}</sup>`;
    }
  },
  updateSubstance() {
    const sel = document.getElementById('u1a-substance');
    const opt = sel.options[sel.selectedIndex];
    const comp = JSON.parse(opt.dataset.comp);
    const labels = Object.keys(comp);
    const data = Object.values(comp);
