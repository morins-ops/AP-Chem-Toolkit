        <div style="margin-top:4px; font-size:0.85em;">
          <strong>Conjugate pairs:</strong>
          ${r.conjugatePairs.map((p,i) => `<span style="color:${i===0?'#E74C3C':'#5DADE2'};">${p.acid} / ${p.base}</span>`).join(' \u2022 ')}
