    }

    // ── Salt bridge — spans between beakers ──
    const sbH = 22;
    const sbX = lx + cellW;
    const sbXend = rx;
    const sbW = sbXend - sbX;
    const sbY = cellY + cellH * 0.45;
    ctx.fillStyle = '#4a4a6a'; ctx.fillRect(sbX, sbY, sbW, sbH);
    ctx.strokeStyle = '#7070a0'; ctx.lineWidth = 1; ctx.strokeRect(sbX, sbY, sbW, sbH);
    ctx.fillStyle = '#bbbbdd'; ctx.font = 'bold 10px Roboto'; ctx.textAlign = 'center';
    ctx.fillText('Salt Bridge (KNO\u2083)', sbX + sbW / 2, sbY + 15);

    // Animated ions in salt bridge — larger dots with readable labels
    if (s.running) {
      const sbCY = sbY + sbH / 2;
      const tCat = s.animT;
      const tAn  = (1 - s.animT) % 1;
      const catX = sbX + tCat * sbW;
      const anX  = sbX + tAn  * sbW;
      // K+ (gold) drifts rightward toward cathode
      ctx.fillStyle = _tg(); ctx.beginPath(); ctx.arc(catX, sbCY - 4, 6, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = _tc('#ffffff','#1A1410'); ctx.font = 'bold 11px Roboto'; ctx.textAlign = 'center';
      ctx.fillText('K\u207A', catX, sbCY - 14);
      // NO3- (blue) drifts leftward toward anode
      ctx.fillStyle = '#5DADE2'; ctx.beginPath(); ctx.arc(anX, sbCY + 4, 6, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = _tc('#ffffff','#1A1410'); ctx.font = 'bold 11px Roboto'; ctx.textAlign = 'center';
      ctx.fillText('NO\u2083\u207B', anX, sbCY + 24);
    }

    // ── Title (top of canvas, above everything) ──
    ctx.fillStyle = '#0d1117'; ctx.fillRect(0, 0, W, 22);
    ctx.fillStyle = _tg(); ctx.font = 'bold 14px Oswald'; ctx.textAlign = 'center';
    ctx.fillText(s.anode.name + ' | ' + s.cathode.name + ' Voltaic Cell', W / 2, 16);

