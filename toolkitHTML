<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AP Chemistry Interactive Toolkit — Mustang High School</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-annotation@3.0.1/dist/chartjs-plugin-annotation.min.js"></script>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Roboto:wght@300;400;500;700&display=swap');

  :root {
    --black: #111111;
    --maroon: #7B1F2E;
    --maroon-dark: #5A1621;
    --maroon-light: #9B2F3E;
    --gold: #CDA349;
    --gold-light: #E8C872;
    --gold-dark: #A8832A;
    --bg-dark: #1A1A1A;
    --bg-card: #222222;
    --bg-card-hover: #2A2A2A;
    --text-primary: #F5F0E8;
    --text-secondary: #B8B0A0;
    --text-muted: #888078;
    --success: #4CAF50;
    --error: #E74C3C;
    --info: #5DADE2;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Roboto', sans-serif;
    background: var(--bg-dark);
    color: var(--text-primary);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ===== SPLASH SCREEN ===== */
  #splash {
    position: fixed; inset: 0;
    background: linear-gradient(135deg, var(--black) 0%, var(--maroon-dark) 50%, var(--black) 100%);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    z-index: 10000;
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  #splash.hidden { opacity: 0; transform: scale(1.05); pointer-events: none; }
  #splash .logo { font-family: 'Oswald', sans-serif; font-size: 2.8em; color: var(--gold); text-transform: uppercase; letter-spacing: 5px; margin-bottom: 5px; text-shadow: 0 0 30px rgba(205,163,73,0.3); }
  #splash .subtitle { font-family: 'Roboto', sans-serif; font-size: 1.1em; color: var(--text-secondary); letter-spacing: 2px; margin-bottom: 20px; }
  #splash .loading-bar { width: 200px; height: 4px; background: rgba(255,255,255,0.1); border-radius: 2px; overflow: hidden; }
  #splash .loading-bar .fill { height: 100%; width: 0%; background: linear-gradient(90deg, var(--gold-dark), var(--gold-light), var(--gold)); border-radius: 2px; animation: loadBar 2s ease-in-out forwards; }
  @keyframes loadBar { 0% { width: 0%; } 100% { width: 100%; } }

  /* ===== HEADER ===== */
  .main-header {
    background: linear-gradient(135deg, var(--maroon-dark) 0%, var(--maroon) 50%, var(--maroon-dark) 100%);
    padding: 10px 20px;
    display: flex; align-items: center; gap: 15px;
    border-bottom: 3px solid var(--gold);
    position: sticky; top: 0; z-index: 1000;
  }
  .main-header .mascot { width: 45px; height: 45px; border-radius: 50%; border: 2px solid var(--gold); overflow: hidden; flex-shrink: 0; }
  .main-header .mascot img { width: 100%; height: 100%; object-fit: cover; }
  .brand-text { flex-shrink: 0; }
  .brand-text .school-name { font-family: 'Oswald', sans-serif; font-size: 1.2em; color: var(--gold); text-transform: uppercase; letter-spacing: 3px; line-height: 1.1; }
  .brand-text .app-name { font-size: 0.65em; color: var(--text-secondary); letter-spacing: 1px; }

  /* ===== UNIT TABS ===== */
  .unit-tabs {
    display: flex; gap: 2px; margin-left: 20px; flex-wrap: wrap; flex: 1;
  }
  .unit-tab {
    font-family: 'Oswald', sans-serif; font-size: 0.72em; font-weight: 600;
    padding: 6px 10px; border-radius: 6px 6px 0 0;
    background: rgba(0,0,0,0.3); color: var(--text-muted);
    cursor: pointer; border: 1px solid transparent; border-bottom: none;
    transition: all 0.2s ease; text-transform: uppercase; letter-spacing: 0.5px;
    white-space: nowrap;
  }
  .unit-tab:hover { background: rgba(0,0,0,0.5); color: var(--text-secondary); }
  .unit-tab.active {
    background: var(--bg-dark); color: var(--gold);
    border-color: var(--gold); border-bottom: 2px solid var(--bg-dark);
    margin-bottom: -3px; position: relative; z-index: 2;
  }
  .unit-tab .unit-num { display: block; font-size: 0.85em; color: var(--gold-dark); line-height: 1; }
  .unit-tab.active .unit-num { color: var(--gold-light); }

  /* ===== SUBTAB BAR ===== */
  .subtab-bar {
    background: var(--bg-card); padding: 0 20px;
    border-bottom: 1px solid rgba(205,163,73,0.15);
    display: flex; gap: 0; overflow-x: auto;
  }
  .subtab {
    font-family: 'Roboto', sans-serif; font-size: 0.78em; font-weight: 500;
    padding: 10px 18px; color: var(--text-muted);
    cursor: pointer; border-bottom: 3px solid transparent;
    transition: all 0.2s ease; white-space: nowrap;
  }
  .subtab:hover { color: var(--text-secondary); background: rgba(205,163,73,0.05); }
  .subtab.active { color: var(--gold); border-bottom-color: var(--gold); }

  /* ===== CONTENT AREA ===== */
  .content-area {
    padding: 20px; max-width: 1400px; margin: 0 auto;
    min-height: calc(100vh - 130px);
  }
  .unit-panel { display: none; }
  .unit-panel.active { display: block; }
  .subtab-panel { display: none; }
  .subtab-panel.active { display: block; animation: fadeIn 0.3s ease; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

  /* ===== SHARED: TOOL CONTAINER ===== */
  .tool-container {
    background: var(--bg-card); border-radius: 12px;
    border: 1px solid rgba(205,163,73,0.15);
    padding: 20px; margin-bottom: 20px; position: relative; overflow: hidden;
  }
  .tool-container::after {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--maroon), var(--gold), var(--maroon));
  }
  .tool-title {
    font-family: 'Oswald', sans-serif; font-size: 1.3em; color: var(--gold);
    text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px; text-align: center;
  }
  .tool-subtitle {
    font-size: 0.85em; color: var(--text-secondary); text-align: center;
    margin-bottom: 20px; line-height: 1.5;
  }

  /* ===== SHARED: EXPLANATION BOX ===== */
  .explanation-box {
    background: rgba(123,31,46,0.15); border-left: 3px solid var(--maroon);
    padding: 12px 15px; border-radius: 0 8px 8px 0; margin-bottom: 15px;
    font-size: 0.85em; line-height: 1.6; color: var(--text-secondary);
  }
  .explanation-box strong { color: var(--gold); }
  .explanation-box .eq { font-family: 'Roboto', sans-serif; font-weight: 700; color: var(--text-primary); }

  /* ===== SHARED: CONTROL GROUPS ===== */
  .controls-row {
    display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 15px; align-items: center;
  }
  .control-group { display: flex; flex-direction: column; gap: 4px; }
  .control-group label { font-size: 0.75em; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; }
  .control-group select, .control-group input[type="number"] {
    background: var(--bg-dark); border: 1px solid rgba(205,163,73,0.2);
    color: var(--text-primary); padding: 6px 10px; border-radius: 6px;
    font-size: 0.85em; font-family: 'Roboto', sans-serif;
  }
  .control-group select:focus, .control-group input:focus { border-color: var(--gold); outline: none; }

  /* ===== SHARED: BUTTONS ===== */
  .btn {
    font-family: 'Oswald', sans-serif; font-weight: 600; font-size: 0.85em;
    padding: 8px 18px; border-radius: 6px; border: none; cursor: pointer;
    text-transform: uppercase; letter-spacing: 1px; transition: all 0.2s ease;
  }
  .btn-primary { background: var(--maroon); color: var(--gold); }
  .btn-primary:hover { background: var(--maroon-light); }
  .btn-gold { background: var(--gold); color: var(--black); }
  .btn-gold:hover { background: var(--gold-light); }
  .btn-outline { background: transparent; border: 1px solid var(--gold); color: var(--gold); }
  .btn-outline:hover { background: rgba(205,163,73,0.1); }
  .btn-sm { font-size: 0.75em; padding: 5px 12px; }

  /* ===== SHARED: GRID LAYOUTS ===== */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .three-col { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 15px; }
  .sidebar-layout { display: grid; grid-template-columns: 300px 1fr; gap: 20px; }
  @media (max-width: 900px) {
    .two-col, .three-col, .sidebar-layout { grid-template-columns: 1fr; }
  }

  /* ===== SHARED: CHART CONTAINERS ===== */
  .chart-container {
    background: rgba(0,0,0,0.3); border-radius: 10px; padding: 15px;
    border: 1px solid rgba(205,163,73,0.08);
  }
  .chart-container h3 {
    font-family: 'Oswald', sans-serif; font-size: 0.85em; color: var(--gold);
    text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 10px; text-align: center;
  }
  .chart-container canvas { width: 100% !important; max-height: 350px; }

  /* ===== SHARED: QUIZ ENGINE ===== */
  .quiz-section {
    background: var(--bg-card); border-radius: 12px;
    border: 1px solid rgba(205,163,73,0.15);
    padding: 20px; margin-top: 20px;
  }
  .quiz-section .quiz-title {
    font-family: 'Oswald', sans-serif; font-size: 1.1em; color: var(--gold);
    text-transform: uppercase; letter-spacing: 2px; margin-bottom: 15px;
    display: flex; align-items: center; gap: 8px;
  }
  .quiz-question {
    background: rgba(0,0,0,0.2); border-radius: 8px; padding: 15px;
    margin-bottom: 12px; border: 1px solid rgba(205,163,73,0.08);
  }
  .quiz-question .q-text {
    font-size: 0.9em; color: var(--text-primary); margin-bottom: 10px; line-height: 1.5;
  }
  .quiz-question .q-num {
    font-family: 'Oswald', sans-serif; color: var(--gold); font-size: 0.8em;
    margin-bottom: 5px; text-transform: uppercase; letter-spacing: 1px;
  }
  .quiz-choices { display: flex; flex-direction: column; gap: 6px; }
  .quiz-choice {
    background: rgba(0,0,0,0.2); border: 1px solid rgba(205,163,73,0.1);
    border-radius: 6px; padding: 8px 12px; cursor: pointer;
    font-size: 0.85em; color: var(--text-secondary); transition: all 0.2s ease;
  }
  .quiz-choice:hover { border-color: var(--gold); color: var(--text-primary); }
  .quiz-choice.selected { border-color: var(--gold); background: rgba(205,163,73,0.1); color: var(--text-primary); }
  .quiz-choice.correct { border-color: var(--success); background: rgba(76,175,80,0.15); color: var(--success); }
  .quiz-choice.incorrect { border-color: var(--error); background: rgba(231,76,60,0.15); color: var(--error); }
  .quiz-choice .choice-letter { font-family: 'Oswald', sans-serif; font-weight: 700; margin-right: 8px; }
  .quiz-feedback {
    font-size: 0.82em; padding: 10px; border-radius: 6px; margin-top: 8px;
    line-height: 1.5; display: none;
  }
  .quiz-feedback.correct { display: block; background: rgba(76,175,80,0.1); border-left: 3px solid var(--success); color: var(--success); }
  .quiz-feedback.incorrect { display: block; background: rgba(231,76,60,0.1); border-left: 3px solid var(--error); color: #E8A0A0; }
  .quiz-score {
    font-family: 'Oswald', sans-serif; font-size: 1.3em; text-align: center;
    color: var(--gold); margin-top: 10px;
  }

  /* ===== SHARED: SLIDER WITH VALUE ===== */
  .slider-group {
    display: flex; align-items: center; gap: 10px; margin-bottom: 8px;
  }
  .slider-group label { font-size: 0.8em; color: var(--text-secondary); min-width: 60px; }
  .slider-group input[type="range"] {
    flex: 1; -webkit-appearance: none; height: 6px;
    background: rgba(205,163,73,0.2); border-radius: 3px; outline: none;
  }
  .slider-group input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none; width: 16px; height: 16px;
    background: var(--gold); border-radius: 50%; cursor: pointer;
  }
  .slider-group .slider-val {
    font-family: 'Roboto', sans-serif; font-size: 0.8em; font-weight: 700;
    color: var(--gold); min-width: 50px; text-align: right;
  }

  /* ===== SHARED: DATA TABLE ===== */
  .data-table {
    width: 100%; border-collapse: collapse; font-size: 0.82em;
  }
  .data-table th {
    font-family: 'Oswald', sans-serif; text-transform: uppercase; letter-spacing: 1px;
    color: var(--gold); padding: 8px; border-bottom: 2px solid var(--gold-dark);
    font-size: 0.85em; text-align: left;
  }
  .data-table td {
    padding: 6px 8px; border-bottom: 1px solid rgba(205,163,73,0.08);
    color: var(--text-secondary);
  }
  .data-table tr:hover td { background: rgba(205,163,73,0.03); }

  /* ===== PLACEHOLDER ===== */
  .placeholder-content {
    text-align: center; padding: 60px 20px;
    color: var(--text-muted); font-size: 1.1em;
  }
  .placeholder-content .icon { font-size: 3em; margin-bottom: 15px; opacity: 0.5; }
  .placeholder-content h2 {
    font-family: 'Oswald', sans-serif; color: var(--text-secondary);
    margin-bottom: 10px; text-transform: uppercase; letter-spacing: 2px;
  }
  .placeholder-content .topics {
    font-size: 0.8em; margin-top: 15px; line-height: 1.8;
  }
  .placeholder-content .topics span {
    display: inline-block; background: rgba(205,163,73,0.1);
    padding: 2px 10px; border-radius: 12px; margin: 2px;
    border: 1px solid rgba(205,163,73,0.15);
  }

  /* ===== LIGHT MODE ===== */
  [data-theme="light"] {
    --bg-dark: #F5F0E5;
    --bg-card: #FFFDF7;
    --bg-card-hover: #F0EBE0;
    --text-primary: #1A1410;
    --text-secondary: #3A3228;
    --text-muted: #5A5348;
    --gold: #6B5010;
    --gold-light: #7A5C12;
    --gold-dark: #5A4210;
    --maroon: #7B1F2E;
    --maroon-light: #9B2F3E;
    --info: #0F6A94;
    --success: #256B28;
    --error: #B71C1C;
    --black: #111;
  }

  /* Base */
  [data-theme="light"] body { background: var(--bg-dark); color: var(--text-primary); }
  [data-theme="light"] #particles { opacity: 0; }

  /* Splash */
  [data-theme="light"] #splash {
    background: linear-gradient(135deg, #F5F0E5 0%, #E8DFD0 50%, #F5F0E5 100%);
  }
  [data-theme="light"] #splash .logo { color: var(--maroon); text-shadow: none; }
  [data-theme="light"] #splash .subtitle { color: #3A3228; }

  /* Header — keep maroon header, but active tab text gets dark gold */
  [data-theme="light"] .main-header {
    background: linear-gradient(135deg, #5A1621 0%, var(--maroon) 50%, #5A1621 100%);
  }
  [data-theme="light"] .unit-tab { background: rgba(255,255,255,0.2); color: rgba(255,255,255,0.65); }
  [data-theme="light"] .unit-tab:hover { background: rgba(255,255,255,0.3); color: #fff; }
  [data-theme="light"] .unit-tab.active {
    background: var(--bg-dark); color: #5A4210;
    border-color: #5A4210; border-bottom-color: var(--bg-dark);
  }
  [data-theme="light"] .unit-tab .unit-num { color: rgba(255,255,255,0.5); }
  [data-theme="light"] .unit-tab.active .unit-num { color: #4A3508; }

  /* Subtab bar */
  [data-theme="light"] .subtab-bar {
    background: #FFFDF7; border-bottom: 1px solid rgba(123,31,46,0.15);
  }
  [data-theme="light"] .subtab { color: #6A6055; }
  [data-theme="light"] .subtab:hover { color: var(--maroon); background: rgba(123,31,46,0.04); }
  [data-theme="light"] .subtab.active { color: var(--maroon); border-bottom-color: var(--maroon); font-weight: 600; }

  /* Tool containers & cards */
  [data-theme="light"] .tool-container {
    background: #FFFDF7; border: 1px solid #D8D0C4;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
  }
  [data-theme="light"] .tool-container::after {
    background: linear-gradient(90deg, var(--maroon), #5A4210, var(--maroon));
  }
  [data-theme="light"] .tool-title { color: #5A1621; }
  [data-theme="light"] .tool-subtitle { color: #3A3228; }

  /* Chart containers — light background instead of dark */
  [data-theme="light"] .chart-container {
    background: #F8F4EC; border: 1px solid #D8D0C4;
  }
  [data-theme="light"] .chart-container h3 { color: #5A1621; }

  /* Explanation boxes */
  [data-theme="light"] .explanation-box {
    background: rgba(123,31,46,0.06); border-left: 3px solid var(--maroon);
    color: #2A2420;
  }
  [data-theme="light"] .explanation-box strong { color: #5A1621; }

  /* Data display panels (inline style overrides for dark bg panels) */
  [data-theme="light"] [style*="background:rgba(0,0,0,0.3)"],
  [data-theme="light"] [style*="background:rgba(0,0,0,0.2)"],
  [data-theme="light"] [style*="background: rgba(0,0,0,0.3)"],
  [data-theme="light"] [style*="background: rgba(0,0,0,0.2)"] {
    background: #F0EBE0 !important;
    border: 1px solid #D8D0C4 !important;
  }

  /* Data tables */
  [data-theme="light"] .data-table th { color: #5A1621; border-bottom-color: #5A1621; }
  [data-theme="light"] .data-table td { border-bottom-color: #D8D0C4; color: #3A3228; }
  [data-theme="light"] .data-table td[style*="color:var(--gold)"] { color: #5A1621 !important; }
  [data-theme="light"] .data-table td[style*="color: var(--gold)"] { color: #5A1621 !important; }
  [data-theme="light"] .data-table tr:hover td { background: rgba(123,31,46,0.04); }

  /* Form controls */
  [data-theme="light"] .control-group label { color: #4A4035; }
  [data-theme="light"] .control-group select,
  [data-theme="light"] .control-group input[type="number"] {
    background: #fff; border: 1px solid #C0B8AC; color: #1A1410;
  }
  [data-theme="light"] .control-group select:focus,
  [data-theme="light"] .control-group input:focus { border-color: var(--maroon); box-shadow: 0 0 0 2px rgba(123,31,46,0.12); }

  /* Sliders */
  [data-theme="light"] .slider-group label { color: #3A3228; }
  [data-theme="light"] .slider-group input[type="range"] { background: #D8D0C4; }
  [data-theme="light"] .slider-group input[type="range"]::-webkit-slider-thumb { background: var(--maroon); }
  [data-theme="light"] .slider-group .slider-val { color: #5A1621; }

  /* Buttons */
  [data-theme="light"] .btn-primary { background: var(--maroon); color: #fff; }
  [data-theme="light"] .btn-primary:hover { background: #9B2F3E; }
  [data-theme="light"] .btn-gold { background: #5A4210; color: #fff; }
  [data-theme="light"] .btn-gold:hover { background: #6B5010; }
  [data-theme="light"] .btn-outline { border-color: var(--maroon); color: var(--maroon); }
  [data-theme="light"] .btn-outline:hover { background: rgba(123,31,46,0.08); }

  /* Quiz */
  [data-theme="light"] .quiz-section {
    background: #FFFDF7; border: 1px solid #D8D0C4;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
  }
  [data-theme="light"] .quiz-section .quiz-title { color: #5A1621; }
  [data-theme="light"] .quiz-question {
    background: #F8F4EC; border: 1px solid #D8D0C4;
  }
  [data-theme="light"] .quiz-question .q-text { color: #1A1410; }
  [data-theme="light"] .quiz-question .q-num { color: #5A1621; }
  [data-theme="light"] .quiz-choice {
    background: #fff; border: 1px solid #C0B8AC; color: #3A3228;
  }
  [data-theme="light"] .quiz-choice:hover { border-color: var(--maroon); color: #1A1410; background: #FFF8F0; }
  [data-theme="light"] .quiz-choice.selected { border-color: var(--maroon); background: rgba(123,31,46,0.08); color: #1A1410; }
  [data-theme="light"] .quiz-choice.correct { border-color: #2E7D32; background: rgba(46,125,50,0.08); color: #1B5E20; }
  [data-theme="light"] .quiz-choice.incorrect { border-color: #C62828; background: rgba(198,40,40,0.08); color: #B71C1C; }
  [data-theme="light"] .quiz-feedback.correct { background: rgba(46,125,50,0.06); border-left-color: #2E7D32; color: #1B5E20; }
  [data-theme="light"] .quiz-feedback.incorrect { background: rgba(198,40,40,0.06); border-left-color: #C62828; color: #B71C1C; }
  [data-theme="light"] .quiz-score { color: #5A1621; }

  /* AP Review sections (inline styled) — override gold color for headings */
  [data-theme="light"] [style*="color:var(--gold)"] { color: #5A1621 !important; }
  [data-theme="light"] [style*="color:var(--maroon)"] { color: #4A1018 !important; }
  [data-theme="light"] [style*="color: var(--gold)"] { color: #5A1621 !important; }
  [data-theme="light"] [style*="color: var(--maroon)"] { color: #4A1018 !important; }
  [data-theme="light"] [style*="background:rgba(212,168,67,0.08)"],
  [data-theme="light"] [style*="background: rgba(212,168,67,0.08)"] {
    background: #F8F4EC !important; border-color: #D8D0C4 !important;
  }
  [data-theme="light"] [style*="background:rgba(212,168,67,0.1)"],
  [data-theme="light"] [style*="background: rgba(212,168,67,0.1)"] {
