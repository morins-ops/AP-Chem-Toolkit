    for (let p2 = -4; p2 <= 4; p2 += 2) {

      const x = toX(Math.pow(10,p2));

      ctx.beginPath(); ctx.moveTo(x,lineY-8); ctx.lineTo(x,lineY+8); ctx.stroke();

      ctx.fillText(`10^${p2}`, x, lineY + 22);

    }

    // K marker

    const kX = toX(r.Keq);

    ctx.fillStyle = '#4CAF50'; ctx.beginPath(); ctx.moveTo(kX,lineY-25); ctx.lineTo(kX-8,lineY-10); ctx.lineTo(kX+8,lineY-10); ctx.fill();

    ctx.font = 'bold 11px Roboto'; ctx.fillText(`K=${r.Keq}`, kX, lineY-30);

    // Q marker

    const qX = toX(Q);

    ctx.fillStyle = '#E74C3C'; ctx.beginPath(); ctx.arc(qX,lineY,8,0,Math.PI*2); ctx.fill();

    ctx.fillStyle = '#fff'; ctx.font = 'bold 10px Roboto'; ctx.fillText('Q', qX, lineY+4);

    ctx.fillStyle = '#E74C3C'; ctx.fillText(`Q=${Q.toFixed(3)}`, qX, lineY+30);

    // Arrow showing direction

    if (Math.abs(qX - kX) > 15) {

      const dir = qX < kX ? 1 : -1;

      ctx.strokeStyle = _tg(); ctx.lineWidth = 3;

      ctx.beginPath(); ctx.moveTo(qX+dir*15,lineY+50); ctx.lineTo(kX-dir*15,lineY+50); ctx.stroke();

      ctx.beginPath(); ctx.moveTo(kX-dir*20,lineY+44); ctx.lineTo(kX-dir*15,lineY+50); ctx.lineTo(kX-dir*20,lineY+56); ctx.fillStyle=_tg(); ctx.fill();

      ctx.font = '11px Roboto'; ctx.fillText(dir>0?'Shift Forward →':'← Shift Reverse', (qX+kX)/2, lineY+70);

    }

    // Labels

    ctx.fillStyle = '#5DADE2'; ctx.font = '10px Roboto';

    ctx.fillText('Q < K: Too few products', W*0.25, H-30);

    ctx.fillStyle = '#E74C3C';

    ctx.fillText('Q > K: Too many products', W*0.75, H-30);

    ctx.fillStyle = '#4CAF50';

    ctx.fillText('Q = K: Equilibrium', W/2, H-15);

  },

  init() { this.update(); }

};



const U7B = {

  update() {

    const K = +document.getElementById('u7b-k').value;

    const a0 = +document.getElementById('u7b-a0').value;

    const b0 = +document.getElementById('u7b-b0').value;

    document.getElementById('u7b-k-val').textContent = K.toFixed(2);

    document.getElementById('u7b-a0-val').textContent = a0.toFixed(2);

    document.getElementById('u7b-b0-val').textContent = b0.toFixed(2);

    // A ⇌ 2B, K = [B]²/[A]

    // At eq: [A] = a0-x, [B] = b0+2x, K = (b0+2x)²/(a0-x)

    // Solve: K(a0-x) = (b0+2x)² → 4x² + (4b0+K)x + (b0²-Ka0) = 0

    const A = 4, B2 = 4*b0+K, C = b0*b0 - K*a0;

    const disc = B2*B2 - 4*A*C;

    let x = disc >= 0 ? (-B2 + Math.sqrt(disc))/(2*A) : 0;

    if (a0 - x < 0) x = a0 * 0.99;

    if (x < -b0/2) x = -b0/2 * 0.99;

    const aeq = a0 - x, beq = b0 + 2*x;

    const Qcheck = aeq > 0 ? (beq*beq)/aeq : Infinity;

    document.getElementById('u7b-table').innerHTML = `

      <table style="width:100%;border-collapse:collapse;font-size:0.85em;text-align:center;">

        <tr style="border-bottom:2px solid var(--gold);color:var(--gold);"><th style="padding:5px;">ICE</th><th>A</th><th>2B</th></tr>

        <tr><td style="color:var(--info)">I</td><td>${a0.toFixed(2)}</td><td>${b0.toFixed(2)}</td></tr>

        <tr><td style="color:var(--error)">C</td><td>−${Math.abs(x).toFixed(3)}</td><td>+${(2*Math.abs(x)).toFixed(3)}</td></tr>

        <tr style="border-top:1px solid var(--gold);font-weight:bold;"><td style="color:var(--success)">E</td><td>${aeq.toFixed(3)}</td><td>${beq.toFixed(3)}</td></tr>

      </table>

      <div style="margin-top:8px;padding:8px;background:rgba(205,163,73,0.1);border-radius:6px;font-size:0.85em;">

        Check: K = [B]²/[A] = ${beq.toFixed(3)}²/${aeq.toFixed(3)} = <span style="color:var(--gold)">${Qcheck.toFixed(3)}</span>

      </div>`;

    this.draw(a0,b0,aeq,beq);

  },

  draw(a0,b0,aeq,beq) {

    const c = document.getElementById('u7b-canvas'); const ctx = c.getContext('2d');

    const W = c.width, H = c.height; ctx.clearRect(0,0,W,H);

    const pad = {l:50,r:20,t:30,b:40};

    const maxC = Math.max(a0,b0,aeq,beq) * 1.3;

    const bw = 60;

    const drawBar = (x,val,label,col) => {

      const h = (val/maxC)*(H-pad.t-pad.b);

      ctx.fillStyle = col+'88'; ctx.fillRect(x,pad.t+H-pad.t-pad.b-h,bw,h);

      ctx.strokeStyle = col; ctx.lineWidth = 2; ctx.strokeRect(x,pad.t+H-pad.t-pad.b-h,bw,h);

      ctx.fillStyle = _tc('#ddd','#333'); ctx.font = '10px Roboto'; ctx.textAlign = 'center';

      ctx.fillText(val.toFixed(3)+' M', x+bw/2, pad.t+H-pad.t-pad.b-h-8);

      ctx.fillText(label, x+bw/2, H-pad.b+15);

    };

    ctx.fillStyle = _tg(); ctx.font = 'bold 12px Roboto'; ctx.textAlign = 'center';

    ctx.fillText('Initial vs Equilibrium Concentrations', W/2, 20);

    drawBar(pad.l+20,a0,'[A]₀','#5DADE2');

    drawBar(pad.l+100,aeq,'[A]eq','#5DADE2');

    drawBar(pad.l+200,b0,'[B]₀','#E74C3C');

    drawBar(pad.l+280,beq,'[B]eq','#E74C3C');

    ctx.strokeStyle = '#666'; ctx.lineWidth = 1;

    ctx.beginPath(); ctx.moveTo(pad.l,pad.t); ctx.lineTo(pad.l,H-pad.b); ctx.lineTo(W-pad.r,H-pad.b); ctx.stroke();

  },

  init() { this.update(); }

};



