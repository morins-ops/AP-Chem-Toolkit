const U5A = {

  update() {

    const m = +document.getElementById('u5a-m').value;

    const n = +document.getElementById('u5a-n').value;

    const k = +document.getElementById('u5a-k').value;

    document.getElementById('u5a-m-val').textContent = m;

    document.getElementById('u5a-n-val').textContent = n;

    document.getElementById('u5a-k-val').textContent = k.toFixed(2);



    // Generate experimental data

    const concs = [[0.10, 0.10], [0.20, 0.10], [0.10, 0.20], [0.20, 0.20]];

    const rates = concs.map(([a,b]) => k * Math.pow(a, m) * Math.pow(b, n));



    const tbl = document.getElementById('u5a-table');

    tbl.innerHTML = `<table style="width:100%; border-collapse:collapse; font-size:0.82em;">

      <tr style="border-bottom:1px solid var(--gold-dark); color:var(--gold);">

        <th style="padding:5px;">Trial</th><th>[A]₀</th><th>[B]₀</th><th>Rate₀ (M/s)</th>

      </tr>

      ${concs.map((c,i) => `<tr${i<2?' style="background:rgba(93,173,226,0.1)"':''}><td style="text-align:center;padding:4px;">${i+1}</td><td style="text-align:center">${c[0].toFixed(2)}</td><td style="text-align:center">${c[1].toFixed(2)}</td><td style="text-align:center">${rates[i].toExponential(2)}</td></tr>`).join('')}

    </table>

    <div style="font-size:0.8em; color:var(--text-muted); margin-top:5px;">

      Trials 1→2: [A] doubles, [B] constant → rate ×${(rates[1]/rates[0]).toFixed(1)} → order m = ${m}<br>

      Trials 1→3: [A] constant, [B] doubles → rate ×${(rates[2]/rates[0]).toFixed(1)} → order n = ${n}

    </div>`;



    const overall = m + n;

    const units = overall === 0 ? 'M/s' : overall === 1 ? 's⁻¹' : overall === 2 ? 'M⁻¹s⁻¹' : `M⁻${overall-1}s⁻¹`;

    document.getElementById('u5a-ratelaw').innerHTML = `<strong>Rate = k[A]<sup>${m}</sup>[B]<sup>${n}</sup></strong><br>

      Overall order: ${overall} | k units: ${units}`;



    this.draw(m, n, k);

  },

  draw(m, n, k) {

    const c = document.getElementById('u5a-canvas');

    const ctx = c.getContext('2d');

    const W = c.width, H = c.height;

    ctx.clearRect(0,0,W,H);



    const pad = {l:55, r:20, t:30, b:40};

    const gW = W-pad.l-pad.r, gH = H-pad.t-pad.b;



    // Plot Rate vs [A] at fixed [B]=0.10

    ctx.strokeStyle = _tc('#444','#bbb'); ctx.lineWidth = 0.5;

    for (let i = 1; i <= 4; i++) {

      const y = pad.t + gH - (i/4)*gH;

      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W-pad.r, y); ctx.stroke();

    }



    ctx.strokeStyle = '#888'; ctx.lineWidth = 1;

    ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, H-pad.b); ctx.lineTo(W-pad.r, H-pad.b); ctx.stroke();



    const maxA = 0.5;

    const maxRate = k * Math.pow(maxA, m) * Math.pow(0.1, n) * 1.2;



    // Rate vs [A] curve

    ctx.beginPath(); ctx.strokeStyle = _tg(); ctx.lineWidth = 2.5;

    for (let a = 0; a <= maxA; a += 0.005) {

      const rate = k * Math.pow(a, m) * Math.pow(0.1, n);

      const x = pad.l + (a/maxA)*gW;

      const y = H - pad.b - (rate/maxRate)*gH;

      if (a === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);

    }

    ctx.stroke();



    // Labels

    ctx.fillStyle = _tc('#aaa','#666'); ctx.font = '10px Roboto'; ctx.textAlign = 'center';

    for (let a = 0; a <= maxA; a += 0.1) {

      ctx.fillText(a.toFixed(1), pad.l + (a/maxA)*gW, H-pad.b+15);

    }

    ctx.fillText('[A] (M)  at fixed [B] = 0.10 M', pad.l+gW/2, H-5);



    ctx.textAlign = 'right';

    for (let i = 0; i <= 4; i++) {

      const val = (maxRate * i/4);

      ctx.fillText(val.toFixed(3), pad.l-5, H-pad.b-(i/4)*gH+4);

    }

    ctx.save(); ctx.translate(12, pad.t+gH/2); ctx.rotate(-Math.PI/2);

    ctx.textAlign = 'center'; ctx.fillText('Rate (M/s)', 0, 0); ctx.restore();



    // Order annotation

    ctx.fillStyle = _tg(); ctx.font = 'bold 12px Roboto'; ctx.textAlign = 'center';

    const shapeName = m === 0 ? 'Horizontal line (rate independent of [A])' :

                     m === 1 ? 'Linear (rate ∝ [A])' :

                     m === 2 ? 'Parabolic (rate ∝ [A]²)' : 'Cubic (rate ∝ [A]³)';

    ctx.fillText(shapeName, pad.l + gW/2, pad.t + 15);

  },

  init() { this.update(); }

};



const U5B = {

  update() {

    const order = +document.getElementById('u5b-order').value;

    const a0 = +document.getElementById('u5b-a0').value;

    const k = +document.getElementById('u5b-k').value;

    document.getElementById('u5b-a0-val').textContent = a0.toFixed(2);

    document.getElementById('u5b-k-val').textContent = k.toFixed(2);



    // Calculate half-life

    let halfLife;

    if (order === 0) halfLife = a0 / (2*k);

    else if (order === 1) halfLife = 0.693 / k;

    else halfLife = 1 / (k * a0);



    const orderNames = ['Zero','First','Second'];

    const intLaws = ['[A] = [A]₀ - kt', 'ln[A] = ln[A]₀ - kt', '1/[A] = 1/[A]₀ + kt'];

    const linearPlots = ['[A] vs t', 'ln[A] vs t', '1/[A] vs t'];

    const units = ['M/s','s⁻¹','M⁻¹s⁻¹'];



    document.getElementById('u5b-info').innerHTML = `

      <strong>${orderNames[order]} Order</strong><br>

      Integrated law: <span style="color:var(--gold)">${intLaws[order]}</span><br>

      Linear plot: ${linearPlots[order]}<br>

      k units: ${units[order]}<br>

      Half-life: <span style="color:var(--gold)">${halfLife.toFixed(2)} s</span>

      ${order === 1 ? ' (constant!)' : order === 0 ? ' (depends on [A]₀)' : ' (depends on [A]₀)'}`;



    this.draw(order, a0, k);

  },

  draw(order, a0, k) {

    const c = document.getElementById('u5b-canvas');

    const ctx = c.getContext('2d');

    const W = c.width, H = c.height;

    ctx.clearRect(0,0,W,H);



    // Three plots side by side: [A] vs t, ln[A] vs t, 1/[A] vs t

    const plotW = (W - 40) / 3;

    const plotH = H - 80;

    const plotY = 35;

    const colors = ['#5DADE2','#4CAF50','#E74C3C'];

    const titles = ['[A] vs t','ln[A] vs t','1/[A] vs t'];



    // Time max depends on order

    let tMax;

    if (order === 0) tMax = a0 / k * 0.95;

    else if (order === 1) tMax = 5 / k;

    else tMax = 10 / (k * a0);

    tMax = Math.min(tMax, 100);



    // Generate data

    const data = [];

    for (let t = 0; t <= tMax; t += tMax/200) {

      let a;

      if (order === 0) a = Math.max(0, a0 - k*t);

      else if (order === 1) a = a0 * Math.exp(-k*t);

      else a = 1 / (1/a0 + k*t);

      data.push({t, a, lnA: a > 0 ? Math.log(a) : -10, invA: 1/a});

    }



    // Draw each plot

    [0,1,2].forEach(pi => {

      const px = 15 + pi * (plotW + 10);

      const isLinear = pi === order;



      // Plot background

      ctx.fillStyle = isLinear ? '#1a2a1a' : '#1a1a2e';

      ctx.fillRect(px, plotY, plotW, plotH);

      ctx.strokeStyle = isLinear ? '#4CAF50' : '#444';

      ctx.lineWidth = isLinear ? 2 : 1;

      ctx.strokeRect(px, plotY, plotW, plotH);



      // Title

      ctx.fillStyle = isLinear ? '#4CAF50' : '#aaa';

      ctx.font = `${isLinear?'bold ':''}11px Roboto`;

      ctx.textAlign = 'center';

      ctx.fillText(titles[pi] + (isLinear ? ' ✓ LINEAR' : ''), px + plotW/2, plotY - 8);



      // Get y-values based on plot type

      const yVals = data.map(d => pi === 0 ? d.a : pi === 1 ? d.lnA : d.invA);

      let yMin = Math.min(...yVals);

      let yMax = Math.max(...yVals);

      if (yMax - yMin < 0.1) { yMax += 0.5; yMin -= 0.5; }

      const yRange = yMax - yMin;



      // Draw curve

      ctx.beginPath();

      ctx.strokeStyle = colors[pi];

      ctx.lineWidth = 2;

      data.forEach((d, di) => {

        const x = px + 5 + (d.t/tMax) * (plotW-10);

        const y = plotY + plotH - 5 - ((yVals[di]-yMin)/yRange) * (plotH-10);

        if (di === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);

      });

      ctx.stroke();



      // Axis labels (minimal)

      ctx.fillStyle = '#666'; ctx.font = '8px Roboto'; ctx.textAlign = 'center';

      ctx.fillText('t →', px + plotW/2, plotY + plotH + 12);

      ctx.fillText(yMin.toFixed(1), px + 3, plotY + plotH - 3);

      ctx.fillText(yMax.toFixed(1), px + 3, plotY + 12);

    });



    // Bottom info

    ctx.fillStyle = _tg(); ctx.font = 'bold 11px Roboto'; ctx.textAlign = 'center';

    ctx.fillText('The plot that gives a STRAIGHT LINE reveals the reaction order.', W/2, H - 15);

    ctx.fillStyle = '#888'; ctx.font = '10px Roboto';

    ctx.fillText(`Green border = linear fit (${['Zero','First','Second'][order]} Order)`, W/2, H - 2);

  },

  init() { this.update(); }

};



const U5C = {

  update() {

    const Er = +document.getElementById('u5c-er').value;

    const Ep = +document.getElementById('u5c-ep').value;

    const Ea = +document.getElementById('u5c-ea').value;

    const catalyst = document.getElementById('u5c-catalyst').checked;

    const multi = document.getElementById('u5c-multi').checked;



    document.getElementById('u5c-er-val').textContent = Er;

    document.getElementById('u5c-ep-val').textContent = Ep;

    document.getElementById('u5c-ea-val').textContent = Ea;



    const dH = Ep - Er;

    const EaRev = Ea + Er - Ep;

    const catEa = Ea * 0.6;



    document.getElementById('u5c-info').innerHTML = `

      ΔH = ${dH > 0 ? '+' : ''}${dH} kJ/mol (${dH < 0 ? 'Exothermic ↓' : dH > 0 ? 'Endothermic ↑' : 'Thermoneutral'})<br>

      E<sub>a</sub> (forward) = <span style="color:var(--gold)">${Ea} kJ/mol</span><br>

      E<sub>a</sub> (reverse) = ${EaRev} kJ/mol<br>

      ${catalyst ? `E<sub>a</sub> (catalyzed) = <span style="color:var(--success)">${catEa.toFixed(0)} kJ/mol</span> (−${(Ea-catEa).toFixed(0)} kJ/mol)` : ''}

      ${multi ? '<br>Shows 2-step mechanism with intermediate' : ''}`;



    this.draw(Er, Ep, Ea, catalyst, multi);

  },

  draw(Er, Ep, Ea, catalyst, multi) {

    const c = document.getElementById('u5c-canvas');

    const ctx = c.getContext('2d');

    const W = c.width, H = c.height;

    ctx.clearRect(0,0,W,H);



    const pad = {l:55, r:30, t:25, b:40};

    const gW = W-pad.l-pad.r, gH = H-pad.t-pad.b;



    const peak = Er + Ea;

    const maxE = Math.max(peak, Ep) * 1.15;



    // Axes

    ctx.strokeStyle = '#666'; ctx.lineWidth = 1;

    ctx.beginPath(); ctx.moveTo(pad.l, pad.t); ctx.lineTo(pad.l, H-pad.b); ctx.lineTo(W-pad.r, H-pad.b); ctx.stroke();



    // Grid

    ctx.strokeStyle = '#333'; ctx.lineWidth = 0.5;

    for (let i = 1; i <= 5; i++) {

      const y = H-pad.b - (i/5)*gH;

      ctx.beginPath(); ctx.moveTo(pad.l, y); ctx.lineTo(W-pad.r, y); ctx.stroke();

    }



    const toY = (e) => H - pad.b - (e/maxE)*gH;

    const toX = (frac) => pad.l + frac*gW;



    if (!multi) {

      // Single-step energy profile

      // Reactant plateau

      ctx.beginPath(); ctx.strokeStyle = '#5DADE2'; ctx.lineWidth = 2.5;

      ctx.moveTo(toX(0), toY(Er)); ctx.lineTo(toX(0.2), toY(Er)); ctx.stroke();



      // Smooth curve up to peak and down to products

      ctx.beginPath(); ctx.strokeStyle = _tg(); ctx.lineWidth = 2.5;

      for (let f = 0; f <= 1; f += 0.01) {

        const x = toX(0.2 + f * 0.6);

        // Gaussian-ish peak

        const e = Er + Ea * Math.exp(-8 * (f-0.4)*(f-0.4));

        // Blend toward products at end

        const blend = f > 0.6 ? (f-0.6)/0.4 : 0;

        const y = toY(e * (1-blend) + Ep * blend);

        if (f === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);

      }

      ctx.stroke();



      // Product plateau

      ctx.beginPath(); ctx.strokeStyle = '#E74C3C'; ctx.lineWidth = 2.5;

      ctx.moveTo(toX(0.8), toY(Ep)); ctx.lineTo(toX(1), toY(Ep)); ctx.stroke();



      // Catalyzed path

      if (catalyst) {

        const catPeak = Er + Ea * 0.6;

        ctx.beginPath(); ctx.strokeStyle = '#4CAF50'; ctx.lineWidth = 2; ctx.setLineDash([6,4]);

        for (let f = 0; f <= 1; f += 0.01) {

          const e = Er + (catPeak-Er) * Math.exp(-8 * (f-0.4)*(f-0.4));

          const blend = f > 0.6 ? (f-0.6)/0.4 : 0;

          const y = toY(e * (1-blend) + Ep * blend);

          const x = toX(0.2 + f * 0.6);

          if (f === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);

        }

        ctx.stroke(); ctx.setLineDash([]);

      }



      // Annotations

      // Ea arrow

      const peakX = toX(0.44);

      ctx.strokeStyle = _tg(); ctx.lineWidth = 1;

      ctx.setLineDash([3,3]);

      ctx.beginPath(); ctx.moveTo(peakX, toY(Er)); ctx.lineTo(peakX, toY(peak)); ctx.stroke();

      ctx.setLineDash([]);

      ctx.fillStyle = _tg(); ctx.font = 'bold 11px Roboto'; ctx.textAlign = 'left';

      ctx.fillText(`Ea = ${Ea}`, peakX+5, toY((Er+peak)/2));



      // ΔH arrow

      const dH = Ep - Er;

      ctx.strokeStyle = dH < 0 ? '#4CAF50' : '#E74C3C'; ctx.lineWidth = 1;

      ctx.setLineDash([3,3]);

      ctx.beginPath(); ctx.moveTo(toX(0.88), toY(Er)); ctx.lineTo(toX(0.88), toY(Ep)); ctx.stroke();

      ctx.setLineDash([]);

      ctx.fillStyle = dH < 0 ? '#4CAF50' : '#E74C3C'; ctx.font = 'bold 11px Roboto';

      ctx.fillText(`ΔH = ${dH > 0 ? '+' : ''}${dH}`, toX(0.88)+5, toY((Er+Ep)/2));



      // Labels

      ctx.fillStyle = '#5DADE2'; ctx.font = '11px Roboto'; ctx.textAlign = 'center';

      ctx.fillText('Reactants', toX(0.1), toY(Er) - 8);

      ctx.fillStyle = '#E74C3C';

      ctx.fillText('Products', toX(0.9), toY(Ep) - 8);

      ctx.fillStyle = '#fff';

      ctx.fillText('Transition State ‡', toX(0.44), toY(peak) - 10);



    } else {

      // Two-step mechanism

      const intE = Er + (Ep-Er)*0.4 + 15; // Intermediate energy

      const peak1 = Er + Ea;

      const peak2 = intE + Ea * 0.7;



      // Reactant plateau

      ctx.beginPath(); ctx.strokeStyle = '#5DADE2'; ctx.lineWidth = 2.5;

      ctx.moveTo(toX(0), toY(Er)); ctx.lineTo(toX(0.12), toY(Er)); ctx.stroke();



      // Step 1 curve

      ctx.beginPath(); ctx.strokeStyle = _tg(); ctx.lineWidth = 2.5;

      for (let f = 0; f <= 1; f += 0.01) {

        const e = Er + (peak1-Er) * Math.exp(-10*(f-0.4)*(f-0.4));

        const blend = f > 0.6 ? (f-0.6)/0.4 : 0;

        const x = toX(0.12 + f*0.35);

        const y = toY(e*(1-blend) + intE*blend);

        if (f===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);

      }

      ctx.stroke();



      // Intermediate plateau

      ctx.beginPath(); ctx.strokeStyle = '#9B59B6'; ctx.lineWidth = 2;

      ctx.moveTo(toX(0.47), toY(intE)); ctx.lineTo(toX(0.53), toY(intE)); ctx.stroke();



      // Step 2 curve

      ctx.beginPath(); ctx.strokeStyle = _tg(); ctx.lineWidth = 2.5;

      for (let f = 0; f <= 1; f += 0.01) {

        const e = intE + (peak2-intE) * Math.exp(-10*(f-0.4)*(f-0.4));

        const blend = f > 0.6 ? (f-0.6)/0.4 : 0;

        const x = toX(0.53 + f*0.35);

        const y = toY(e*(1-blend) + Ep*blend);

        if (f===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);

      }

      ctx.stroke();



      // Product plateau

      ctx.beginPath(); ctx.strokeStyle = '#E74C3C'; ctx.lineWidth = 2.5;

      ctx.moveTo(toX(0.88), toY(Ep)); ctx.lineTo(toX(1), toY(Ep)); ctx.stroke();



      // Labels

      ctx.fillStyle = '#5DADE2'; ctx.font = '10px Roboto'; ctx.textAlign = 'center';

      ctx.fillText('Reactants', toX(0.06), toY(Er)-8);

      ctx.fillStyle = '#9B59B6';

      ctx.fillText('Intermediate', toX(0.5), toY(intE)-8);

      ctx.fillStyle = '#E74C3C';

      ctx.fillText('Products', toX(0.94), toY(Ep)-8);

      ctx.fillStyle = '#fff'; ctx.font = '9px Roboto';

      ctx.fillText('TS₁ ‡', toX(0.26), toY(peak1)-8);

      ctx.fillText('TS₂ ‡', toX(0.67), toY(peak2)-8);

      ctx.fillStyle = _tg(); ctx.font = '10px Roboto';

      ctx.fillText('Step 1 (slow)', toX(0.26), H-pad.b+15);

      ctx.fillText('Step 2 (fast)', toX(0.67), H-pad.b+15);

    }



    // Axis labels

    ctx.fillStyle = _tc('#aaa','#666'); ctx.font = '10px Roboto'; ctx.textAlign = 'center';

    ctx.fillText('Reaction Coordinate →', pad.l+gW/2, H-5);

    ctx.save(); ctx.translate(12, pad.t+gH/2); ctx.rotate(-Math.PI/2);

    ctx.fillText('Potential Energy (kJ/mol)', 0, 0); ctx.restore();



    // Y-axis scale

    ctx.textAlign = 'right';

    for (let i = 0; i <= 5; i++) {

      const e = (maxE * i / 5);

      ctx.fillText(Math.round(e).toString(), pad.l-5, toY(e)+4);

    }



    if (catalyst) {

      ctx.fillStyle = '#4CAF50'; ctx.font = '10px Roboto'; ctx.textAlign = 'left';

      ctx.fillText('--- Catalyzed pathway (lower Ea)', pad.l + 5, pad.t + 12);

    }

  },

  init() { this.update(); }

};



