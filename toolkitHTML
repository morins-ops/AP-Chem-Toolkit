    levels.forEach((lv, i) => {

      const x = pad.l + i * stepW + 10;

      const y = toY(lv.E);

      ctx.fillStyle = colors[i%5]; ctx.strokeStyle = colors[i%5]; ctx.lineWidth = 3;

