  parseFormula(formula) {
    // Normalize: replace subscript/superscript unicode with ASCII
    let f = formula.trim();
    // Handle charge notation: ClO3-, MnO4^-, SO4^2-, Fe3+, etc.
    let charge = 0;
    // Check for trailing charge like "2-", "-", "3+", "+"
    const chargeMatch = f.match(/([0-9]*)([+\-\u207a\u207b\u2212\u207c])$/);
    if (chargeMatch) {
      const num = chargeMatch[1] ? parseInt(chargeMatch[1]) : 1;
      const sign = (chargeMatch[2] === '+' || chargeMatch[2] === '\u207a') ? 1 : -1;
      charge = num * sign;
      f = f.substring(0, f.length - chargeMatch[0].length);
    }
    // Replace unicode subscripts with digits
    f = f.replace(/\u2080/g,'0').replace(/\u2081/g,'1').replace(/\u2082/g,'2').replace(/\u2083/g,'3')
         .replace(/\u2084/g,'4').replace(/\u2085/g,'5').replace(/\u2086/g,'6').replace(/\u2087/g,'7')
         .replace(/\u2088/g,'8').replace(/\u2089/g,'9');
    // Parse elements and counts
    const elements = [];
    const re = /([A-Z][a-z]?)(\d*)/g;
    let m;
    while ((m = re.exec(f)) !== null) {
      if (m[1]) {
        elements.push({symbol: m[1], count: m[2] ? parseInt(m[2]) : 1});
      }
    }
    return {elements, charge};
  },

  calcOxStates() {
    const input = document.getElementById('u4c-ox-formula').value.trim();
    const result = document.getElementById('u4c-ox-result');
    if (!input) { result.innerHTML = '<span style="color:#ff9;">Please enter a formula.</span>'; return; }

    const parsed = this.parseFormula(input);
    if (parsed.elements.length === 0) {
      result.innerHTML = '<span style="color:#E74C3C;">Could not parse formula. Try something like H2SO4, KMnO4, or ClO3-</span>';
      return;
    }

    const steps = [];
    let knownSum = 0;
    let unknownEl = null;
    let unknownCount = 0;
    const assignments = [];

    // Check for special cases
    const isPeroxide = (input.match(/O2/i) && (input.match(/Na2O2|H2O2|BaO2|K2O2/i)));
    const isHydride = input.match(/NaH|KH|CaH2|LiH|MgH2/i);

    parsed.elements.forEach((el) => {
      let oxState = null;
      // Apply rules in priority order
      if (el.symbol === 'F') {
        oxState = -1;
        steps.push(`${el.symbol} is always \u22121 \u2192 ${el.count > 1 ? el.count + '(' : ''}${oxState > 0 ? '+' : ''}${oxState}${el.count > 1 ? ') = ' + (el.count * oxState) : ''}`);
      } else if (this.knownOxStates[el.symbol] && el.symbol !== 'O' && el.symbol !== 'H') {
        oxState = this.knownOxStates[el.symbol];
        const group = ['Li','Na','K','Rb','Cs','Fr'].includes(el.symbol) ? 'Group 1 \u2192 +1' :
                      ['Be','Mg','Ca','Sr','Ba'].includes(el.symbol) ? 'Group 2 \u2192 +2' :
                      el.symbol === 'Al' ? 'Al \u2192 +3' : el.symbol === 'Ag' ? 'Ag \u2192 +1' : el.symbol === 'Zn' ? 'Zn \u2192 +2' : '';
        steps.push(`${el.symbol} is ${group} (always ${oxState > 0 ? '+' : ''}${oxState}) \u2192 ${el.count > 1 ? el.count + '\u00d7(' + (oxState > 0 ? '+' : '') + oxState + ') = ' + (el.count * oxState) : (oxState > 0 ? '+' : '') + oxState}`);
      } else if (el.symbol === 'H') {
        oxState = isHydride ? -1 : 1;
        steps.push(`H is ${isHydride ? '\u22121 (metal hydride)' : 'usually +1'} \u2192 ${el.count > 1 ? el.count + '\u00d7(' + (oxState > 0 ? '+' : '') + oxState + ') = ' + (el.count * oxState) : (oxState > 0 ? '+' : '') + oxState}`);
      } else if (el.symbol === 'O') {
        oxState = isPeroxide ? -1 : -2;
        steps.push(`O is ${isPeroxide ? '\u22121 (peroxide)' : 'usually \u22122'} \u2192 ${el.count > 1 ? el.count + '\u00d7(' + oxState + ') = ' + (el.count * oxState) : '' + oxState}`);
      } else {
        unknownEl = el.symbol;
        unknownCount = el.count;
      }

      if (oxState !== null) {
        knownSum += oxState * el.count;
        assignments.push({symbol: el.symbol, count: el.count, state: oxState});
      }
    });

    if (unknownEl) {
      const unknownTotal = parsed.charge - knownSum;
      const unknownState = unknownTotal / unknownCount;
      steps.push(`Sum rule: all oxidation states must equal ${parsed.charge !== 0 ? 'ion charge (' + (parsed.charge > 0 ? '+' : '') + parsed.charge + ')' : '0 (neutral compound)'}`);
      steps.push(`${unknownCount > 1 ? unknownCount : ''}${unknownEl} + (${knownSum > 0 ? '+' : ''}${knownSum}) = ${parsed.charge} \u2192 ${unknownCount > 1 ? unknownCount + '\u00d7' : ''}${unknownEl} = ${unknownTotal} \u2192 ${unknownEl} = ${unknownState > 0 ? '+' : ''}${unknownState}`);
      assignments.push({symbol: unknownEl, count: unknownCount, state: unknownState});
    }

    // Build result HTML
    let html = '<div style="padding:10px; background:rgba(205,163,73,0.1); border-radius:8px;">';
    html += `<div style="margin-bottom:8px; font-weight:bold;">Formula: ${input}${parsed.charge !== 0 ? ' (charge: ' + (parsed.charge > 0 ? '+' : '') + parsed.charge + ')' : ''}</div>`;
    steps.forEach((s,i) => {
      html += `<div style="padding:4px 8px; margin:3px 0; background:rgba(0,0,0,0.15); border-radius:4px; font-size:0.88em; border-left:3px solid var(--gold);">
        <strong style="color:var(--gold);">Step ${i+1}:</strong> ${s}</div>`;
    });
    html += '<div style="margin-top:8px; padding:8px; background:rgba(93,173,226,0.1); border-radius:4px;">';
    html += '<strong>Result:</strong> ';
    html += assignments.map(a => `<span style="color:${a.state > 0 ? '#ff8888' : a.state < 0 ? '#88ff88' : '#fff'};">${a.symbol} = ${a.state > 0 ? '+' : ''}${Number.isInteger(a.state) ? a.state : a.state.toFixed(2)}</span>`).join(' \u2022 ');
    html += '</div></div>';
    result.innerHTML = html;
  },

