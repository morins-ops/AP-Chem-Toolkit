      }

    });

    // Direct path arrow

    ctx.strokeStyle = _tg(); ctx.lineWidth = 2; ctx.setLineDash([8,4]);

    const y0 = toY(0), yf = toY(cumE);

    ctx.beginPath(); ctx.moveTo(pad.l+20,y0); ctx.quadraticCurveTo(W-pad.r-20,(y0+yf)/2-30,W-pad.r-40,yf); ctx.stroke();

    ctx.setLineDash([]);

    ctx.fillStyle = _tg(); ctx.font = 'bold 12px Roboto'; ctx.textAlign = 'center';

    ctx.fillText(`Direct: ΔH = ${ex.sum} kJ`, W/2, Math.min(y0,yf)-20);

