  draw(ex) {

    const c = document.getElementById('u6c-canvas'); const ctx = c.getContext('2d');

    const W = c.width, H = c.height; ctx.clearRect(0,0,W,H);

    const pad = {l:50,r:30,t:30,b:30};

    // Draw enthalpy diagram

    const levels = [{label:'Reactants',E:0}];

    let cumE = 0;

    ex.steps.forEach((s,i) => { cumE += s.dH; levels.push({label:`Step ${i+1}`,E:cumE}); });

    const minE = Math.min(0, ...levels.map(l=>l.E)) - 50;

    const maxE = Math.max(0, ...levels.map(l=>l.E)) + 50;

    const toY = e => pad.t + (H-pad.t-pad.b) * (1 - (e-minE)/(maxE-minE));

