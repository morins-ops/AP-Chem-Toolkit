  draw(pH) {

    const c = document.getElementById('u8a-canvas'); const ctx = c.getContext('2d');

    const W = c.width, H = c.height; ctx.clearRect(0,0,W,H);

    const pad = {l:30,r:30,t:60,b:40};

    const barH = 50, barY = pad.t;

    // pH scale rainbow bar

    for(let i=0;i<=W-pad.l-pad.r;i++){

      const pH2 = (i/(W-pad.l-pad.r))*14;

      const hue = (1-pH2/14)*360;

      ctx.fillStyle = `hsl(${hue},70%,50%)`; ctx.fillRect(pad.l+i,barY,1,barH);

    }

    ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.strokeRect(pad.l,barY,W-pad.l-pad.r,barH);

    // pH labels

    ctx.fillStyle='#fff';ctx.font='10px Roboto';ctx.textAlign='center';

    for(let p=0;p<=14;p++){

      const x=pad.l+(p/14)*(W-pad.l-pad.r);

      ctx.fillText(p.toString(),x,barY+barH+15);

      ctx.beginPath();ctx.moveTo(x,barY+barH);ctx.lineTo(x,barY+barH+5);ctx.strokeStyle='#fff';ctx.lineWidth=1;ctx.stroke();

    }

    // Current pH marker

    const px=pad.l+(pH/14)*(W-pad.l-pad.r);

    ctx.beginPath();ctx.moveTo(px,barY-5);ctx.lineTo(px-8,barY-20);ctx.lineTo(px+8,barY-20);ctx.closePath();

    ctx.fillStyle='#fff';ctx.fill();

    ctx.font='bold 14px Roboto';ctx.fillText(`pH = ${pH.toFixed(2)}`,px,barY-25);

    // Region labels

    ctx.font='bold 12px Roboto';ctx.textAlign='center';

    ctx.fillStyle='#E74C3C';ctx.fillText('ACIDIC',pad.l+(W-pad.l-pad.r)*0.2,barY+barH+35);

    ctx.fillStyle='#4CAF50';ctx.fillText('NEUTRAL',W/2,barY+barH+35);

    ctx.fillStyle='#5DADE2';ctx.fillText('BASIC',pad.l+(W-pad.l-pad.r)*0.8,barY+barH+35);

    // Bar chart: [H+] vs [OH-]

    const chartY = barY + barH + 60;

    const chartH = H - chartY - pad.b;

    const Hconc = Math.pow(10,-pH), OHconc = 1e-14/Hconc;

    const maxLog = 1, minLog = -14;

    const hBar = ((Math.log10(Hconc)-minLog)/(maxLog-minLog))*chartH;

    const ohBar = ((Math.log10(OHconc)-minLog)/(maxLog-minLog))*chartH;

    ctx.fillStyle='#E74C3C88';ctx.fillRect(W*0.3,chartY+chartH-hBar,60,hBar);

    ctx.strokeStyle='#E74C3C';ctx.lineWidth=2;ctx.strokeRect(W*0.3,chartY+chartH-hBar,60,hBar);

    ctx.fillStyle='#5DADE288';ctx.fillRect(W*0.6,chartY+chartH-ohBar,60,ohBar);

    ctx.strokeStyle='#5DADE2';ctx.strokeRect(W*0.6,chartY+chartH-ohBar,60,ohBar);

    ctx.fillStyle='#E74C3C';ctx.font='11px Roboto';ctx.textAlign='center';

    ctx.fillText('[H⁺]',W*0.3+30,chartY+chartH+15);

    ctx.fillText(Hconc.toExponential(1),W*0.3+30,chartY+chartH-hBar-5);

    ctx.fillStyle='#5DADE2';

    ctx.fillText('[OH⁻]',W*0.6+30,chartY+chartH+15);

    ctx.fillText(OHconc.toExponential(1),W*0.6+30,chartY+chartH-ohBar-5);

  },

  init() { this.update(); }

};



const U8B = {

  update() {

    const type = +document.getElementById('u8b-type').value;

    const Ca = +document.getElementById('u8b-ca').value;

    const Va = +document.getElementById('u8b-va').value;

    const Ct = +document.getElementById('u8b-ct').value;

    const Vt = +document.getElementById('u8b-vt').value;

    document.getElementById('u8b-ca-val').textContent = Ca.toFixed(2);

    document.getElementById('u8b-va-val').textContent = Va;

    document.getElementById('u8b-ct-val').textContent = Ct.toFixed(2);

    document.getElementById('u8b-vt-val').textContent = Vt.toFixed(1);

    const eqVol = (Ca*Va)/Ct;

    const Ka = type===1?1.8e-5:type===3?4.3e-7:1e7;

    const Kb = type===2?1.8e-5:1e7;

    // Calculate pH at current volume

    const molesA = Ca * Va / 1000, molesT = Ct * Vt / 1000;

    let pH;

    if(type===0){// SA + SB

      if(molesT<molesA){const H=(molesA-molesT)/((Va+Vt)/1000);pH=-Math.log10(H);}

      else if(molesT>molesA){const OH=(molesT-molesA)/((Va+Vt)/1000);pH=14+Math.log10(OH);}

      else pH=7;

    }else if(type===1){// WA + SB

      if(molesT<molesA*0.001){const H=Math.sqrt(Ka*Ca);pH=-Math.log10(H);}

      else if(molesT<molesA){const ratio=(molesA-molesT)/molesT;pH=-Math.log10(Ka)+Math.log10(ratio);pH=(-Math.log10(Ka*10)+(14-(-Math.log10(Ka))))/2;pH=-Math.log10(Ka)+Math.log10((molesA-molesT)/molesT);}

      else if(Math.abs(molesT-molesA)<0.0001){const Kb2=1e-14/Ka;const conj=molesA/((Va+Vt)/1000);const OH=Math.sqrt(Kb2*conj);pH=14+Math.log10(OH);}

      else{const OH=(molesT-molesA)/((Va+Vt)/1000);pH=14+Math.log10(OH);}

    }else if(type===2){// SA + WB

      if(molesT<molesA*0.001){pH=-Math.log10(Ca);}

      else if(molesT<molesA){const H=(molesA-molesT)/((Va+Vt)/1000);pH=-Math.log10(H);}

      else if(Math.abs(molesT-molesA)<0.0001){const Ka2=1e-14/Kb;const conj=molesA/((Va+Vt)/1000);const H=Math.sqrt(Ka2*conj);pH=-Math.log10(H);}

      else{const Bex=(molesT-molesA)/((Va+Vt)/1000);const OH=Math.sqrt(Kb*Bex);pH=14+Math.log10(OH);}

    }else{// Diprotic WA + SB

      const Ka1=4.3e-7,Ka2=5.6e-11;

      if(molesT<molesA){pH=-Math.log10(Ka1)+Math.log10((molesA-molesT)/Math.max(0.001,molesT));}

      else if(Math.abs(molesT-molesA)<0.0001){pH=(-Math.log10(Ka1)-Math.log10(Ka2))/2;}

      else if(molesT<2*molesA){pH=-Math.log10(Ka2)+Math.log10((2*molesA-molesT)/Math.max(0.001,molesT-molesA));}

      else{const OH=(molesT-2*molesA)/((Va+Vt)/1000);pH=14+Math.log10(Math.max(1e-14,OH));}

    }

    pH = Math.max(0,Math.min(14,pH));

    document.getElementById('u8b-info').innerHTML = `Equiv. vol = <span style="color:var(--gold)">${eqVol.toFixed(1)} mL</span><br>Current pH = <span style="color:var(--gold)">${pH.toFixed(2)}</span><br>${Vt<eqVol*0.99?'Before equivalence':(Vt>eqVol*1.01?'After equivalence':'At equivalence')}`;

    this.draw(type, Ca, Va, Ct, eqVol, Vt, pH);

  },

  draw(type, Ca, Va, Ct, eqVol, Vt, currentPH) {

    const c = document.getElementById('u8b-canvas'); const ctx = c.getContext('2d');

    const W = c.width, H = c.height; ctx.clearRect(0,0,W,H);

    const pad = {l:50,r:20,t:30,b:40};

    const gW=W-pad.l-pad.r, gH=H-pad.t-pad.b;

    const maxVol = eqVol * 2.2;

    const Ka = type===1?1.8e-5:type===3?4.3e-7:1e7;

    const Kb = type===2?1.8e-5:1e7;

    // Generate full curve

    ctx.beginPath(); ctx.strokeStyle=_tg(); ctx.lineWidth=2.5;

    for(let v=0;v<=maxVol;v+=0.5){

      const mA=Ca*Va/1000, mT=Ct*v/1000;

      let ph;

      if(type===0){if(mT<mA){ph=-Math.log10((mA-mT)/((Va+v)/1000));}else if(mT>mA){ph=14+Math.log10((mT-mA)/((Va+v)/1000));}else ph=7;}

      else if(type===1){if(v<0.5){ph=-Math.log10(Math.sqrt(Ka*Ca));}else if(mT<mA){ph=-Math.log10(Ka)+Math.log10((mA-mT)/mT);}else if(Math.abs(mT-mA)<0.001){const c2=mA/((Va+v)/1000);ph=14+Math.log10(Math.sqrt(1e-14/Ka*c2));}else{ph=14+Math.log10((mT-mA)/((Va+v)/1000));}}

      else if(type===2){if(v<0.5){ph=-Math.log10(Ca);}else if(mT<mA){ph=-Math.log10((mA-mT)/((Va+v)/1000));}else if(Math.abs(mT-mA)<0.001){const c2=mA/((Va+v)/1000);ph=-Math.log10(Math.sqrt(1e-14/Kb*c2));}else{ph=14+Math.log10(Math.sqrt(Kb*(mT-mA)/((Va+v)/1000)));}}

      else{const Ka1=4.3e-7,Ka2=5.6e-11;if(v<0.5){ph=-Math.log10(Math.sqrt(Ka1*Ca));}else if(mT<mA){ph=-Math.log10(Ka1)+Math.log10((mA-mT)/mT);}else if(Math.abs(mT-mA)<0.001){ph=(-Math.log10(Ka1)-Math.log10(Ka2))/2;}else if(mT<2*mA){ph=-Math.log10(Ka2)+Math.log10((2*mA-mT)/Math.max(0.001,mT-mA));}else{ph=14+Math.log10(Math.max(1e-14,(mT-2*mA)/((Va+v)/1000)));}}

      ph=Math.max(0,Math.min(14,ph));

      const x=pad.l+(v/maxVol)*gW, y=pad.t+gH-(ph/14)*gH;

      if(v===0)ctx.moveTo(x,y);else ctx.lineTo(x,y);

    }

    ctx.stroke();

    // Current point

    const ptX=pad.l+(Vt/maxVol)*gW, ptY=pad.t+gH-(currentPH/14)*gH;

    ctx.beginPath();ctx.arc(ptX,ptY,6,0,Math.PI*2);ctx.fillStyle='#E74C3C';ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.stroke();

    // Equivalence line

    const eqX=pad.l+(eqVol/maxVol)*gW;

    ctx.setLineDash([4,4]);ctx.strokeStyle='#888';ctx.lineWidth=1;

    ctx.beginPath();ctx.moveTo(eqX,pad.t);ctx.lineTo(eqX,pad.t+gH);ctx.stroke();ctx.setLineDash([]);

    ctx.fillStyle='#888';ctx.font='9px Roboto';ctx.textAlign='center';ctx.fillText('Equiv.',eqX,pad.t-5);

    // pH 7 line

    const y7=pad.t+gH-(7/14)*gH;

    ctx.setLineDash([2,4]);ctx.strokeStyle='#4CAF5044';ctx.beginPath();ctx.moveTo(pad.l,y7);ctx.lineTo(W-pad.r,y7);ctx.stroke();ctx.setLineDash([]);

    // Axes

    ctx.strokeStyle='#888';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(pad.l,pad.t);ctx.lineTo(pad.l,pad.t+gH);ctx.lineTo(W-pad.r,pad.t+gH);ctx.stroke();

    ctx.fillStyle=_tc('#aaa','#666');ctx.font='10px Roboto';ctx.textAlign='center';

    for(let v=0;v<=maxVol;v+=Math.ceil(maxVol/5)){ctx.fillText(v.toFixed(0),pad.l+(v/maxVol)*gW,H-pad.b+15);}

    ctx.fillText('Volume of Titrant (mL)',pad.l+gW/2,H-5);

    ctx.textAlign='right';for(let p=0;p<=14;p+=2){ctx.fillText(p.toString(),pad.l-5,pad.t+gH-(p/14)*gH+4);}

    ctx.save();ctx.translate(12,pad.t+gH/2);ctx.rotate(-Math.PI/2);ctx.textAlign='center';ctx.fillText('pH',0,0);ctx.restore();

    const names=['SA+SB','WA+SB','SA+WB','Diprotic WA+SB'];

    ctx.fillStyle=_tg();ctx.font='bold 12px Roboto';ctx.textAlign='center';ctx.fillText(names[type]+' Titration Curve',W/2,20);

  },

  init() { this.update(); }

};



