    ctx.beginPath(); ctx.moveTo(cbX-4, cbY-50); ctx.lineTo(cbX, cbY-44); ctx.lineTo(cbX+4, cbY-50); ctx.fillStyle='rgba(255,255,255,0.3)'; ctx.fill();
