  drawPES(el) {

    const canvas = document.getElementById('u1c-pes-canvas');

    const ctx = canvas.getContext('2d');

    const W = canvas.width, H = canvas.height;

    ctx.clearRect(0, 0, W, H);



    // White background

    ctx.fillStyle = '#FAFAFA';

    ctx.fillRect(0, 0, W, H);



    // Plot area

    const padL = 55, padR = 20, padT = 15, padB = 45;

    const plotW = W - padL - padR;

    const plotH = H - padT - padB;



    // Determine x-axis range (log scale, descending: high BE on left)

    const allBE = el.subshells.map(s => s.be);

    const maxBE = Math.max(...allBE);

    const minBE = Math.min(...allBE);

    // Expand range for visual breathing room

    const logMax = Math.log10(maxBE * 2.5);

    const logMin = Math.log10(Math.max(0.05, minBE * 0.4));



    function beToX(be) {

      const logBe = Math.log10(Math.max(0.01, be));

      // Descending: high BE on left (logMax maps to left, logMin maps to right)

      const t = (logBe - logMin) / (logMax - logMin);

      return padL + (1 - t) * plotW;

    }



    // Max electrons for y scaling

    const maxE = Math.max(...el.subshells.map(s => s.e));



    function eToY(e) {

      return padT + plotH - (e / (maxE + 1)) * plotH;

    }



    // Draw horizontal gridlines

    ctx.strokeStyle = '#D0D0D0';

    ctx.lineWidth = 0.5;

    for (let i = 0; i <= 5; i++) {

      const gy = padT + (i / 5) * plotH;

      ctx.beginPath(); ctx.moveTo(padL, gy); ctx.lineTo(padL + plotW, gy); ctx.stroke();

    }



    // Draw axes

    ctx.strokeStyle = '#333';

    ctx.lineWidth = 1.5;

    // Y-axis

    ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, padT + plotH); ctx.stroke();

    // X-axis

    ctx.beginPath(); ctx.moveTo(padL, padT + plotH); ctx.lineTo(padL + plotW, padT + plotH); ctx.stroke();

    // Y-axis arrow

    ctx.beginPath(); ctx.moveTo(padL - 5, padT + 5); ctx.lineTo(padL, padT - 3); ctx.lineTo(padL + 5, padT + 5); ctx.stroke();



    // Y-axis label (rotated)

    ctx.save();

    ctx.translate(14, padT + plotH / 2);

    ctx.rotate(-Math.PI / 2);

    ctx.fillStyle = '#333';

    ctx.font = 'bold 11px Arial';

    ctx.textAlign = 'center';

    ctx.fillText('Relative Number', 0, 0);

    ctx.fillText('of Electrons', 0, 13);

    ctx.restore();



    // X-axis label

    ctx.fillStyle = '#333';

    ctx.font = 'bold 11px Arial';

    ctx.textAlign = 'center';

    ctx.fillText('Binding Energy (MJ/mol)', padL + plotW / 2, H - 5);



    // X-axis tick marks (logarithmic)

    const tickValues = [0.1, 0.5, 1, 5, 10, 50, 100, 500, 1000];

    ctx.font = '9px Arial';

    ctx.fillStyle = '#555';

    ctx.textAlign = 'center';

    tickValues.forEach(tv => {

      const logTv = Math.log10(tv);

      if (logTv >= logMin && logTv <= logMax) {

        const tx = beToX(tv);

        ctx.beginPath();

        ctx.moveTo(tx, padT + plotH);

        ctx.lineTo(tx, padT + plotH + 5);

        ctx.strokeStyle = '#333'; ctx.lineWidth = 1;

        ctx.stroke();

        ctx.fillText(tv >= 1 ? tv.toString() : tv.toFixed(1), tx, padT + plotH + 16);

      }

    });



    // Draw peaks as Gaussian curves

    const peakWidth = 0.06; // in log space

    el.subshells.forEach(sub => {

      const centerX = beToX(sub.be);

      const peakY = eToY(sub.e);

      const baseY = padT + plotH;



      // Draw peak as a series of line segments forming a Gaussian

      ctx.beginPath();

      ctx.moveTo(centerX - 40, baseY);



      const nPoints = 80;

      for (let i = 0; i <= nPoints; i++) {

        const dx = (i / nPoints - 0.5) * 80; // pixels from center

        const px = centerX + dx;

        // Gaussian: height * exp(-dx^2 / (2*sigma^2))

        const sigma = 6; // pixel width of peak

        const height = baseY - peakY;

        const gy = baseY - height * Math.exp(-(dx * dx) / (2 * sigma * sigma));

        if (i === 0) ctx.moveTo(px, gy);

        else ctx.lineTo(px, gy);

      }



      ctx.strokeStyle = '#111';

      ctx.lineWidth = 1.8;

      ctx.stroke();



      // Fill under the peak

      ctx.lineTo(centerX + 40, baseY);

      ctx.lineTo(centerX - 40, baseY);

      ctx.closePath();

      ctx.fillStyle = 'rgba(0,0,0,0.08)';

      ctx.fill();



      // Label the peak with subshell name

      ctx.fillStyle = '#333';

      ctx.font = 'bold 10px Arial';

      ctx.textAlign = 'center';

      ctx.fillText(sub.label, centerX, peakY - 8);

    });

  },



  init() {

    // Populate element dropdown

    const sel = document.getElementById('u1c-element');

    sel.innerHTML = this.elements.map((el, i) =>

      `<option value="${i}">${el.Z}. ${el.sym} — ${el.name}</option>`

    ).join('');



