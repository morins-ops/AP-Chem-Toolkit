    document.getElementById('u3d-l-val').textContent = path.toFixed(2);

    document.getElementById('u3d-e-val').textContent = eps;



    const A = eps * path * conc;

    const T_pct = Math.pow(10, -A) * 100;



    const calc = document.getElementById('u3d-calc');

    calc.innerHTML = `<strong>Beer-Lambert Law: A = εbc</strong><br>

      A = (${eps})(${path.toFixed(2)})(${conc.toFixed(2)})<br>

      <strong style="color:var(--gold)">Absorbance = ${A.toFixed(3)}</strong><br>

