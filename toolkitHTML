  // ============ OXIDATION STATE CALCULATOR ============
  knownOxStates: {
    'F':-1,'Li':1,'Na':1,'K':1,'Rb':1,'Cs':1,'Fr':1,
    'Be':2,'Mg':2,'Ca':2,'Sr':2,'Ba':2,'Al':3,'Ag':1,'Zn':2
