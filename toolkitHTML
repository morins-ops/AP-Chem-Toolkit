  update() {
    const sel = document.getElementById('u1a-substance');
    const opt = sel.options[sel.selectedIndex];
    const mm = parseFloat(opt.dataset.mass);
    const moles = parseFloat(document.getElementById('u1a-moles').value);
    const mass = moles * mm;
    const particles = moles * 6.022e23;
    document.getElementById('u1a-moles-val').textContent = moles.toFixed(2);
    document.getElementById('u1a-disp-moles').textContent = moles.toFixed(2);
    document.getElementById('u1a-disp-mass').textContent = mass.toFixed(2);
