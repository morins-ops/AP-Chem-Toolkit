    const maxElecH = cellH * 0.65;

    // ── Helper: drift ions gently inside their beaker, keeping away from electrode center ──
    // Uses constant-speed drift with tiny random perturbation so ions never speed up
    const DRIFT_SPEED = 0.0006;
    function driftIons(ions) {
      for (const ion of ions) {
        // Clamp velocity to constant gentle speed each frame (prevents acceleration)
        const speed = Math.sqrt(ion.vx * ion.vx + ion.vy * ion.vy);
        if (speed > 0) {
          ion.vx = (ion.vx / speed) * DRIFT_SPEED;
          ion.vy = (ion.vy / speed) * DRIFT_SPEED;
        }
        // Tiny random wiggle for natural Brownian look
        ion.vx += (Math.random() - 0.5) * 0.0001;
        ion.vy += (Math.random() - 0.5) * 0.0001;

        ion.x += ion.vx;
        ion.y += ion.vy;
        // Bounce off beaker walls (0-1 normalized), stay in lower portion of beaker
        if (ion.x < 0.06 || ion.x > 0.94) ion.vx *= -1;
        if (ion.y < 0.50 || ion.y > 0.90) ion.vy *= -1;
        ion.x = Math.max(0.06, Math.min(0.94, ion.x));
        ion.y = Math.max(0.50, Math.min(0.90, ion.y));
        // Push away from electrode center column (0.5 ± 0.18)
        if (ion.x > 0.32 && ion.x < 0.68) {
          ion.x = (ion.x < 0.5) ? 0.30 : 0.70;
          ion.vx *= -1;
        }
      }
    }
    if (s.running) { driftIons(s.anodeIons); driftIons(s.cathodeIons); }

    // ── Anode beaker ──
    ctx.fillStyle = s.anode.solColor;
    ctx.fillRect(lx, cellY, cellW, cellH);
    ctx.strokeStyle = '#5DADE2'; ctx.lineWidth = 2;
    ctx.strokeRect(lx, cellY, cellW, cellH);

    // Anode electrode (dissolving — shrinks from bottom up)
    const anodeElecH = maxElecH * anodeFrac;
    const anodeElecX = lx + cellW / 2 - electrodeW / 2;
    ctx.fillStyle = s.anode.color;
    ctx.fillRect(anodeElecX, cellY - 15, electrodeW, anodeElecH);

    // Draw anode ions in solution — large labeled circles
    for (const ion of s.anodeIons) {
