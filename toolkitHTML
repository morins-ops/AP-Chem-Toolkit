      const iy = cellY + ion.y * cellH;
      ctx.fillStyle = 'rgba(93,173,226,0.85)';
      ctx.beginPath(); ctx.arc(ix, iy, 8, 0, Math.PI * 2); ctx.fill();
      ctx.fillStyle = _tc('#ffffff','#1A1410'); ctx.font = 'bold 12px Roboto'; ctx.textAlign = 'center';
      ctx.fillText(s.anode.ion, ix, iy + 20);
    }

    // Anode electrode mass label (on the electrode itself, near top)
    ctx.fillStyle = _tc('#ddd','#333'); ctx.font = '9px Roboto'; ctx.textAlign = 'center';
    ctx.fillText(s.anodeMass.toFixed(1) + ' g', anodeElecX + electrodeW / 2, cellY + 10);

    // Anode label below beaker
    ctx.fillStyle = '#5DADE2'; ctx.font = 'bold 11px Roboto'; ctx.textAlign = 'center';
    ctx.fillText('ANODE (\u2212)', lx + cellW / 2, cellY + cellH + 16);
    ctx.font = '10px Roboto';
    ctx.fillText(s.anode.name + ' \u2192 ' + s.anode.ion + ' + ' + s.anode.n + 'e\u207B', lx + cellW / 2, cellY + cellH + 30);
    ctx.fillStyle = _tc('#8888aa','#666'); ctx.font = '9px Roboto';
    ctx.fillText('OXIDATION', lx + cellW / 2, cellY + cellH + 42);

    // ── Cathode beaker ──
    ctx.fillStyle = s.cathode.solColor;
    ctx.fillRect(rx, cellY, cellW, cellH);
    ctx.strokeStyle = '#E74C3C'; ctx.lineWidth = 2;
    ctx.strokeRect(rx, cellY, cellW, cellH);

    // Cathode electrode (growing — gains mass)
    const cathodeElecH = maxElecH * Math.min(cathodeFrac, 1.0);
    const cathodeElecX = rx + cellW / 2 - electrodeW / 2;
    ctx.fillStyle = s.cathode.color;
    ctx.fillRect(cathodeElecX, cellY - 15, electrodeW, cathodeElecH);

    // Draw cathode ions in solution — large labeled circles
    for (const ion of s.cathodeIons) {
      const ix = rx + ion.x * cellW;
