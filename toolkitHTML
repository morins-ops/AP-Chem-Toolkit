  setTrend(trend) {
    this.currentTrend = trend;
    ['radius', 'ie', 'en', 'ea'].forEach(t => {
      const btn = document.getElementById(`u1d-btn-${t}`);
      btn.className = t === trend ? 'btn btn-gold btn-sm' : 'btn btn-outline btn-sm';
    });
    const labels = { radius: 'ATOMIC RADIUS (pm)', ie: 'IONIZATION ENERGY (kJ/mol)', en: 'ELECTRONEGATIVITY', ea: 'ELECTRON AFFINITY (kJ/mol)' };
    document.getElementById('u1d-trend-label').textContent = labels[trend];
    this.drawPT();
  },
  getColor(value, min, max) {
    if (value === 0 || value === undefined) return 'rgba(50,50,50,0.5)';
    const t = (value - min) / (max - min || 1);
    const r = Math.round(205 + (123 - 205) * t);
    const g = Math.round(163 + (31 - 163) * t);
    const b = Math.round(73 + (46 - 73) * t);
    return `rgb(${r},${g},${b})`;
  },
  cellW: 50, cellH: 46, padX: 5, padY: 22,
  // Map display rows: rows 1-7 are periods, row 9/10 are lanthanides/actinides drawn below with a gap
  getDrawY(row) {
    if (row <= 7) return this.padY + (row - 1) * this.cellH;
    // Rows 9,10 = lanthanides/actinides, drawn below period 7 with a gap
    return this.padY + 7 * this.cellH + 12 + (row - 9) * this.cellH;
  },
  drawPT() {
    const canvas = document.getElementById('u1d-pt-canvas');
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height;
    ctx.clearRect(0, 0, W, H);
    const {cellW, cellH, padX} = this;
    const trend = this.currentTrend;
    const key = trend === 'radius' ? 'r' : trend;
    const vals = this.elements.map(e => e[key]).filter(v => v > 0);
    const min = Math.min(...vals);
    const max = Math.max(...vals);
    this.elements.forEach(el => {
      const x = padX + (el.col - 1) * cellW;
      const y = this.getDrawY(el.row);
      const val = el[key];
      ctx.fillStyle = this.getColor(val, min, max);
      ctx.fillRect(x, y, cellW - 2, cellH - 2);
      ctx.strokeStyle = 'rgba(205,163,73,0.2)';
      ctx.lineWidth = 0.5;
      ctx.strokeRect(x, y, cellW - 2, cellH - 2);
      // Symbol
      ctx.fillStyle = '#F5F0E8';
      ctx.font = 'bold 11px Oswald';
      ctx.textAlign = 'center';
      ctx.fillText(el.sym, x + cellW/2 - 1, y + 20);
      // Atomic number
      ctx.fillStyle = 'rgba(245,240,232,0.6)';
      ctx.font = '7px Roboto';
      ctx.fillText(el.Z, x + cellW/2 - 1, y + 10);
      // Value
      if (val > 0) {
        ctx.fillStyle = 'rgba(245,240,232,0.45)';
        ctx.font = '7px Roboto';
        const display = trend === 'en' ? val.toFixed(1) : val;
        ctx.fillText(display, x + cellW/2 - 1, y + 34);
      }
    });
    ctx.textAlign = 'left';
    // Lanthanide/Actinide labels
    const lnY = this.getDrawY(9);
    const acY = this.getDrawY(10);
    ctx.fillStyle = '#B8B0A0';
    ctx.font = '8px Roboto';
    ctx.fillText('Lanthanides', padX, lnY + cellH/2 + 3);
    ctx.fillText('Actinides', padX, acY + cellH/2 + 3);
    // Connector indicators on row 6 col 3 and row 7 col 3
    const indX = padX + 2 * cellW + cellW/2;
    ctx.fillStyle = '#B8B0A0';
    ctx.font = '7px Roboto';
    ctx.textAlign = 'center';
    ctx.fillText('*', indX, this.getDrawY(6) + cellH/2);
    ctx.fillText('**', indX, this.getDrawY(7) + cellH/2);
    ctx.fillText('*', padX + 2 * cellW - 6, lnY + 10);
    ctx.fillText('**', padX + 2 * cellW - 6, acY + 10);
    // Legend
    ctx.textAlign = 'left';
    const lgX = 280, lgY = 5;
    const gradW = 180, gradH = 10;
    const grad = ctx.createLinearGradient(lgX, lgY, lgX + gradW, lgY);
    grad.addColorStop(0, 'rgb(205,163,73)');
    grad.addColorStop(1, 'rgb(123,31,46)');
    ctx.fillStyle = grad;
    ctx.fillRect(lgX, lgY, gradW, gradH);
    ctx.fillStyle = '#B8B0A0';
    ctx.font = '9px Roboto';
    ctx.fillText('Low', lgX - 25, lgY + 9);
    ctx.fillText('High', lgX + gradW + 5, lgY + 9);
  },
  init() {
    this.ptCanvas = document.getElementById('u1d-pt-canvas');
    this.ptCtx = this.ptCanvas.getContext('2d');
    const self = this;
    this.ptCanvas.addEventListener('mousemove', function(e) {
      const rect = self.ptCanvas.getBoundingClientRect();
      const scaleX = self.ptCanvas.width / rect.width;
      const scaleY = self.ptCanvas.height / rect.height;
      const mx = (e.clientX - rect.left) * scaleX;
      const my = (e.clientY - rect.top) * scaleY;
      const {cellW, cellH, padX} = self;
      const col = Math.floor((mx - padX) / cellW) + 1;
      // Determine row from y position
      let foundEl = null;
      self.elements.forEach(function(el) {
        const ey = self.getDrawY(el.row);
        const ex = padX + (el.col - 1) * cellW;
        if (mx >= ex && mx <= ex + cellW - 2 && my >= ey && my <= ey + cellH - 2) foundEl = el;
      });
      const info = document.getElementById('u1d-element-info');
      if (foundEl) {
        const el = foundEl;
        info.innerHTML = '<span style="font-family:Oswald; font-size:1.5em; color:var(--gold)">' + el.sym + '</span>' +
          '<span style="color:var(--text-muted); margin-left:8px;">(Z = ' + el.Z + ')</span><br>' +
          '<span style="font-size:0.82em;">Atomic Radius: <strong>' + el.r + ' pm</strong> | IE: <strong>' + el.ie + ' kJ/mol</strong> | EN: <strong>' + el.en + '</strong> | EA: <strong>' + el.ea + ' kJ/mol</strong></span>';
      }
    });
    this.drawPT();
  }
};



