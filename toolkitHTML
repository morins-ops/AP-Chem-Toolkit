    // E°cell label
    const Q = s.anodeConc / s.cathodeConc;
    const Enow = Math.max(0, s.Ecell_std - (0.0592 / s.n_eff) * Math.log10(Q));
    // E° values displayed in the gap between beakers, above salt bridge
    ctx.fillStyle = _tg(); ctx.font = 'bold 10px Roboto'; ctx.textAlign = 'center';
    const gapCX = (lx + cellW + rx) / 2;  // center of gap between beakers
    ctx.fillText('E\u00B0 = ' + s.Ecell_std.toFixed(2) + ' V', gapCX, cellY + cellH * 0.20);
