      s1.max = Math.round(5 * r.r1mw); s1.step = 0.5; s1.value = (2 * r.r1mw).toFixed(1);
      s2.max = Math.round(5 * r.r2mw); s2.step = 0.5; s2.value = (2 * r.r2mw).toFixed(1);
    } else {
      document.getElementById('u4b-unit1').textContent = 'mol';
      document.getElementById('u4b-unit2').textContent = 'mol';
      s1.max = 5; s1.step = 0.1; s1.value = 2;
      s2.max = 5; s2.step = 0.1; s2.value = 2;
    }
    this.update();
  },

  update() {
    const idx = +document.getElementById('u4b-rxn').value;
    const r = this.reactions[idx];
    const massMode = document.getElementById('u4b-mass-mode').checked;
    const raw1 = +document.getElementById('u4b-mol1').value;
    const raw2 = +document.getElementById('u4b-mol2').value;
    document.getElementById('u4b-r1-name').textContent = r.r1;
    document.getElementById('u4b-r2-name').textContent = r.r2;

    let mol1, mol2;
    if (massMode) {
      document.getElementById('u4b-mol1-val').textContent = raw1.toFixed(1);
      document.getElementById('u4b-mol2-val').textContent = raw2.toFixed(1);
      mol1 = raw1 / r.r1mw;
      mol2 = raw2 / r.r2mw;
    } else {
      document.getElementById('u4b-mol1-val').textContent = raw1.toFixed(2);
      document.getElementById('u4b-mol2-val').textContent = raw2.toFixed(2);
      mol1 = raw1;
      mol2 = raw2;
    }

    const ratio1 = mol1 / r.r1coeff;
    const ratio2 = mol2 / r.r2coeff;
    const limiting = ratio1 <= ratio2 ? 1 : 2;
    const limitingMol = Math.min(ratio1, ratio2);
    const productMols = r.pcoeffs.map(c => limitingMol * c);
    const excessMol = limiting === 1 ? mol2 - limitingMol * r.r2coeff : mol1 - limitingMol * r.r1coeff;

    this._theoreticalYieldG = productMols[0] * r.pmws[0];
    this._lastCalc = { r, mol1, mol2, limiting, limitingMol, productMols, excessMol };

    const massInfo = massMode ? `<br><em style="font-size:0.82em; color:var(--text-muted);">${raw1.toFixed(1)} g ${r.r1} ÷ ${r.r1mw} g/mol = ${mol1.toFixed(3)} mol &nbsp;|&nbsp; ${raw2.toFixed(1)} g ${r.r2} ÷ ${r.r2mw} g/mol = ${mol2.toFixed(3)} mol</em>` : '';

    document.getElementById('u4b-result').innerHTML = `<strong>Reaction: ${r.eq}</strong>${massInfo}<br><br>
      <strong>Mole Ratios:</strong><br>
      ${r.r1}: ${mol1.toFixed(3)} mol ÷ ${r.r1coeff} = <span style="color:${limiting===1?'var(--error)':'var(--success)'}">${ratio1.toFixed(3)}</span><br>
      ${r.r2}: ${mol2.toFixed(3)} mol ÷ ${r.r2coeff} = <span style="color:${limiting===2?'var(--error)':'var(--success)'}">${ratio2.toFixed(3)}</span><br><br>
      <strong style="color:var(--error)">Limiting Reagent: ${limiting===1?r.r1:r.r2}</strong><br>
      Excess ${limiting===1?r.r2:r.r1}: ${excessMol.toFixed(3)} mol remaining<br><br>
      <strong>Products Formed:</strong><br>
      ${r.products.map((p,i) => `${p}: ${productMols[i].toFixed(3)} mol (${(productMols[i]*r.pmws[i]).toFixed(2)} g)`).join('<br>')}`;

    document.getElementById('u4b-yield-info').innerHTML = `Theoretical yield of ${r.products[0]}: <strong>${this._theoreticalYieldG.toFixed(2)} g</strong>`;
    this.calcPercentYield();
    this.updateWorkedExample(r, mol1, mol2, limiting, limitingMol, productMols);
    this.drawInitial(r, mol1, mol2);
  },

  calcPercentYield() {
    const actual = +document.getElementById('u4b-actual-yield').value;
    const el = document.getElementById('u4b-percent-yield');
    if (actual > 0 && this._theoreticalYieldG > 0) {
      const pct = (actual / this._theoreticalYieldG) * 100;
      el.innerHTML = `= <strong>${pct.toFixed(1)}%</strong> yield`;
      el.style.color = pct > 100 ? 'var(--error)' : pct > 90 ? 'var(--success)' : 'var(--gold)';
    } else { el.textContent = ''; }
  },

  updateWorkedExample(r, mol1, mol2, limiting, limitingMol, productMols) {
    const el = document.getElementById('u4b-worked');
    const limName = limiting === 1 ? r.r1 : r.r2;
    const limMol = limiting === 1 ? mol1 : mol2;
    const limCoeff = limiting === 1 ? r.r1coeff : r.r2coeff;
    const limMW = limiting === 1 ? r.r1mw : r.r2mw;
    const grams = limMol * limMW;
    el.innerHTML = `
      <div style="font-size:0.88em; line-height:1.8;">
        <div style="margin-bottom:10px; color:var(--gold); font-weight:bold;">Given ${mol1.toFixed(2)} mol ${r.r1} and ${mol2.toFixed(2)} mol ${r.r2}, how much ${r.products[0]} forms?</div>
        <div style="padding:8px; background:rgba(0,0,0,0.15); border-radius:6px; margin-bottom:8px;">
          <strong>Step 1: Find the limiting reagent</strong><br>
          &nbsp;&nbsp;${r.r1}: ${mol1.toFixed(3)} mol ÷ ${r.r1coeff} = ${(mol1/r.r1coeff).toFixed(3)}<br>
          &nbsp;&nbsp;${r.r2}: ${mol2.toFixed(3)} mol ÷ ${r.r2coeff} = ${(mol2/r.r2coeff).toFixed(3)}<br>
          &nbsp;&nbsp;→ <strong style="color:var(--error)">${limName}</strong> has the smaller ratio → limiting reagent
        </div>
        <div style="padding:8px; background:rgba(0,0,0,0.15); border-radius:6px; margin-bottom:8px;">
          <strong>Step 2: Mole ratio → moles of product</strong><br>
          &nbsp;&nbsp;${limMol.toFixed(3)} mol ${limName} × (${r.pcoeffs[0]} mol ${r.products[0]} / ${limCoeff} mol ${limName}) = <strong>${productMols[0].toFixed(3)} mol ${r.products[0]}</strong>
        </div>
        <div style="padding:8px; background:rgba(0,0,0,0.15); border-radius:6px; margin-bottom:8px;">
          <strong>Step 3: Convert to grams</strong><br>
          &nbsp;&nbsp;${productMols[0].toFixed(3)} mol × ${r.pmws[0]} g/mol = <strong style="color:var(--success)">${(productMols[0]*r.pmws[0]).toFixed(2)} g ${r.products[0]}</strong>
        </div>
        <div style="padding:8px; background:rgba(93,173,226,0.1); border-radius:6px;">
          <strong>Full Roadmap:</strong><br>
          <span style="color:var(--info);">${grams.toFixed(1)} g ${limName}</span> <span style="opacity:0.5">÷ ${limMW}</span> → <span style="color:var(--info);">${limMol.toFixed(3)} mol</span> <span style="opacity:0.5">× ${r.pcoeffs[0]}/${limCoeff}</span> → <span style="color:var(--info);">${productMols[0].toFixed(3)} mol ${r.products[0]}</span> <span style="opacity:0.5">× ${r.pmws[0]}</span> → <span style="color:var(--success); font-weight:bold;">${(productMols[0]*r.pmws[0]).toFixed(2)} g</span>
        </div>
      </div>`;
  },

  // ===== ANIMATION =====
  drawInitial(r, mol1, mol2) {
    if (this._animFrame) { cancelAnimationFrame(this._animFrame); this._animFrame = null; }
    const c = document.getElementById('u4b-canvas');
    const ctx = c.getContext('2d');
    const W = c.width, H = c.height;
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    const bg = isLight ? '#F0EBE0' : '#1a1a2e';
    const text = isLight ? '#1A1410' : '#dddddd';
    const muted = isLight ? '#6A6055' : '#888888';
    const gold = isLight ? '#5A4210' : '#CDA349';

    const n1 = Math.min(Math.round(mol1 * 6), 30);
    const n2 = Math.min(Math.round(mol2 * 6), 30);
    this._particles = { r1: [], r2: [], products: [] };
    // Place r1 on the left, r2 on the right
    for (let i = 0; i < n1; i++) {
      this._particles.r1.push({ x: 30 + Math.random() * (W/2 - 60), y: 60 + Math.random() * (H - 110), alpha: 1 });
    }
    for (let i = 0; i < n2; i++) {
      this._particles.r2.push({ x: W/2 + 30 + Math.random() * (W/2 - 60), y: 60 + Math.random() * (H - 110), alpha: 1 });
    }

    ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
    ctx.fillStyle = gold; ctx.font = 'bold 14px Roboto'; ctx.textAlign = 'center';
    ctx.fillText('Before Reaction — Press Play!', W/2, 22);
    // Legend
    ctx.font = '11px Roboto'; ctx.textAlign = 'left';
    ctx.fillStyle = '#5DADE2'; ctx.beginPath(); ctx.arc(20, 42, 6, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = text; ctx.fillText(`${r.r1} (${mol1.toFixed(2)} mol)`, 30, 46);
    ctx.fillStyle = '#E74C3C'; ctx.beginPath(); ctx.arc(200, 42, 6, 0, Math.PI*2); ctx.fill();
    ctx.fillStyle = text; ctx.fillText(`${r.r2} (${mol2.toFixed(2)} mol)`, 210, 46);
    // Draw particles
    this._particles.r1.forEach(p => {
      ctx.beginPath(); ctx.arc(p.x, p.y, 8, 0, Math.PI*2);
      ctx.fillStyle = '#5DADE2'; ctx.fill();
      ctx.strokeStyle = '#3498DB'; ctx.lineWidth = 1.5; ctx.stroke();
    });
    this._particles.r2.forEach(p => {
      ctx.beginPath(); ctx.arc(p.x, p.y, 8, 0, Math.PI*2);
      ctx.fillStyle = '#E74C3C'; ctx.fill();
      ctx.strokeStyle = '#C0392B'; ctx.lineWidth = 1.5; ctx.stroke();
    });
    // Divider line
    ctx.setLineDash([4,4]); ctx.strokeStyle = muted; ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(W/2, 55); ctx.lineTo(W/2, H - 20); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = muted; ctx.font = '10px Roboto'; ctx.textAlign = 'center';
    ctx.fillText(r.r1, W/4, H - 8);
    ctx.fillText(r.r2, 3*W/4, H - 8);

    const btn = document.getElementById('u4b-play-btn');
    btn.textContent = '▶ Play Reaction'; btn.disabled = false;
  },

  playAnimation() {
    if (!this._lastCalc || !this._particles) return;
    const btn = document.getElementById('u4b-play-btn');
    btn.textContent = 'Playing...'; btn.disabled = true;

    const c = document.getElementById('u4b-canvas');
    const ctx = c.getContext('2d');
    const W = c.width, H = c.height;
    const isLight = document.documentElement.getAttribute('data-theme') === 'light';
    const bg = isLight ? '#F0EBE0' : '#1a1a2e';
    const text = isLight ? '#1A1410' : '#dddddd';
    const muted = isLight ? '#6A6055' : '#888888';
    const gold = isLight ? '#5A4210' : '#CDA349';
    const lc = this._lastCalc;
    const r = lc.r;
    const pColors = ['#4CAF50','#E8A838','#9B59B6'];

    // How many of each to consume
    let r1Consume, r2Consume;
    if (lc.limiting === 1) {
      r1Consume = this._particles.r1.length;
      r2Consume = Math.round(this._particles.r2.length * (1 - lc.excessMol / lc.mol2));
    } else {
      r2Consume = this._particles.r2.length;
      r1Consume = Math.round(this._particles.r1.length * (1 - lc.excessMol / lc.mol1));
    }
    r2Consume = Math.min(r2Consume, this._particles.r2.length);
    r1Consume = Math.min(r1Consume, this._particles.r1.length);

    // Create product particles in center
    const totalConsumed = r1Consume + r2Consume;
    const numProd = Math.max(3, Math.min(Math.round(totalConsumed * 0.6), 25));
    this._particles.products = [];
    for (let i = 0; i < numProd; i++) {
      const pi = i % r.products.length;
      this._particles.products.push({
        x: W/2 + (Math.random() - 0.5) * 200, y: H/2 + (Math.random() - 0.5) * 150,
        color: pColors[pi % 3], alpha: 0, label: r.products[pi]
      });
    }

    // Randomize consumption order
    const r1Idx = this._particles.r1.map((_, i) => i).sort(() => Math.random() - 0.5);
    const r2Idx = this._particles.r2.map((_, i) => i).sort(() => Math.random() - 0.5);

    let frame = 0;
    const totalFrames = 150;

    const animate = () => {
      frame++;
      const progress = frame / totalFrames;

      // Fade out consumed reactants
      const r1Done = Math.floor(r1Consume * Math.min(progress * 1.3, 1));
      for (let i = 0; i < r1Done && i < r1Idx.length; i++) {
        this._particles.r1[r1Idx[i]].alpha = Math.max(0, this._particles.r1[r1Idx[i]].alpha - 0.06);
      }
      const r2Done = Math.floor(r2Consume * Math.min(progress * 1.3, 1));
      for (let i = 0; i < r2Done && i < r2Idx.length; i++) {
        this._particles.r2[r2Idx[i]].alpha = Math.max(0, this._particles.r2[r2Idx[i]].alpha - 0.06);
      }

      // Fade in products after 20% progress
      if (progress > 0.2) {
        const prodProg = (progress - 0.2) / 0.8;
        const prodDone = Math.floor(this._particles.products.length * prodProg);
        for (let i = 0; i < prodDone; i++) {
          this._particles.products[i].alpha = Math.min(this._particles.products[i].alpha + 0.04, 1);
        }
      }

      // Draw frame
      ctx.fillStyle = bg; ctx.fillRect(0, 0, W, H);
      const isDone = frame >= totalFrames;
      ctx.fillStyle = gold; ctx.font = 'bold 14px Roboto'; ctx.textAlign = 'center';
      ctx.fillText(isDone ? 'Reaction Complete!' : 'Reaction in Progress...', W/2, 22);

      // Legend
      ctx.font = '11px Roboto'; ctx.textAlign = 'left';
      ctx.fillStyle = '#5DADE2'; ctx.beginPath(); ctx.arc(20, 42, 6, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = text; ctx.fillText(r.r1, 30, 46);
      ctx.fillStyle = '#E74C3C'; ctx.beginPath(); ctx.arc(120, 42, 6, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = text; ctx.fillText(r.r2, 130, 46);
      r.products.forEach((p, pi) => {
        const lx = 220 + pi * 80;
        ctx.fillStyle = pColors[pi % 3]; ctx.beginPath(); ctx.arc(lx, 42, 6, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = text; ctx.fillText(p, lx + 10, 46);
      });

      // Draw r1 particles
      this._particles.r1.forEach(p => {
        if (p.alpha <= 0) return;
        ctx.globalAlpha = p.alpha;
        ctx.beginPath(); ctx.arc(p.x, p.y, 8, 0, Math.PI*2);
        ctx.fillStyle = '#5DADE2'; ctx.fill();
        ctx.strokeStyle = '#3498DB'; ctx.lineWidth = 1.5; ctx.stroke();
        ctx.globalAlpha = 1;
      });
      // Draw r2 particles
      this._particles.r2.forEach(p => {
        if (p.alpha <= 0) return;
        ctx.globalAlpha = p.alpha;
        ctx.beginPath(); ctx.arc(p.x, p.y, 8, 0, Math.PI*2);
        ctx.fillStyle = '#E74C3C'; ctx.fill();
        ctx.strokeStyle = '#C0392B'; ctx.lineWidth = 1.5; ctx.stroke();
        ctx.globalAlpha = 1;
      });
      // Draw product particles
      this._particles.products.forEach(p => {
        if (p.alpha <= 0) return;
        ctx.globalAlpha = p.alpha;
        ctx.beginPath(); ctx.arc(p.x, p.y, 9, 0, Math.PI*2);
        ctx.fillStyle = p.color; ctx.fill();
        ctx.strokeStyle = p.color; ctx.lineWidth = 2; ctx.stroke();
        ctx.globalAlpha = 1;
      });

      // Bottom info when done
      if (isDone) {
        const limName = lc.limiting === 1 ? r.r1 : r.r2;
        const exName = lc.limiting === 1 ? r.r2 : r.r1;
        ctx.fillStyle = '#ff5555'; ctx.font = 'bold 12px Roboto'; ctx.textAlign = 'center';
        ctx.fillText(`Limiting Reagent: ${limName} (completely consumed)`, W/2, H - 30);
        ctx.fillStyle = muted; ctx.font = '11px Roboto';
        ctx.fillText(`Excess ${exName}: ${lc.excessMol.toFixed(3)} mol remaining`, W/2, H - 12);
      }

      if (frame < totalFrames) {
        this._animFrame = setTimeout(animate, 16);
      } else {
        this._animFrame = null;
        btn.textContent = '✓ Complete';
      }
    };
    this._animFrame = setTimeout(animate, 16);
  },

  resetAnimation() {
    if (this._animFrame) { clearTimeout(this._animFrame); this._animFrame = null; }
    this.update();
  },

  init() { this.update(); }
};



