  // ── One simulation step ──
  tick() {
    const s = this.state;
    if (!s.running) return;

    const speed = +document.getElementById('u9c-speed').value;
    const dt = 10 * speed;   // simulated seconds per real tick
    const I = 0.50;          // assumed current 0.5 A
    const F = 96485;

    // Faraday's Law: mol transferred = I * dt / (n * F)
    const mol = (I * dt) / (s.n_eff * F);

    // Anode loses mass, cathode gains mass (adjusted for molar masses)
    const anodeMolLost  = mol;
    const cathodeMolGained = (I * dt) / (s.cathode.n * F);

    s.anodeMass   = Math.max(0, s.anodeMass   - anodeMolLost * s.anode.molarMass);
    s.cathodeMass = s.cathodeMass + cathodeMolGained * s.cathode.molarMass;

    // Update concentrations: assume 0.5 L solution each half-cell
    const V_sol = 0.50; // liters
    s.anodeConc   = Math.max(0.0001, s.anodeConc   + anodeMolLost    / V_sol);
    s.cathodeConc = Math.max(0.0001, s.cathodeConc - cathodeMolGained / V_sol);

    s.time += dt;
    s.tickCount++;

    // Add/remove ion particles every 12 ticks to visualize concentration change
    if (s.tickCount % 12 === 0) {
      // Anode: metal oxidizes → new cation appears at electrode surface, drifts outward (max 14)
      if (s.anodeIons.length < 14) {
        const side = Math.random() < 0.5 ? 0.31 : 0.69; // right at electrode edge
        const yPos = 0.55 + Math.random() * 0.25; // spread vertically in solution
        s.anodeIons.push({x: side, y: yPos, vx: (side < 0.5 ? -1 : 1) * 0.0006, vy: (Math.random() - 0.5) * 0.0004});
      }
      // Cathode: cation nearest electrode plates out → remove it from solution (min 0)
      if (s.cathodeIons.length > 0) {
        // Find ion closest to electrode center (x ≈ 0.50) and remove it
        let closestIdx = 0;
        let closestDist = Math.abs(s.cathodeIons[0].x - 0.50);
        for (let i = 1; i < s.cathodeIons.length; i++) {
          const d = Math.abs(s.cathodeIons[i].x - 0.50);
          if (d < closestDist) { closestDist = d; closestIdx = i; }
        }
        s.cathodeIons.splice(closestIdx, 1);
      }
    }

    // Nernst equation: Q = [anode ion] / [cathode ion]  (simplified for 1:1)
    const Q = s.anodeConc / s.cathodeConc;
    const E = s.Ecell_std - (0.0592 / s.n_eff) * Math.log10(Q);
    const Eclipped = Math.max(0, E);

    s.voltageHistory.push({t: s.time, V: Eclipped});

    // Record chart point every ~10 ticks
    if (s.voltageHistory.length % 3 === 0 && this.chart) {
      this.chart.data.labels.push(this.formatTime(s.time));
      this.chart.data.datasets[0].data.push(+Eclipped.toFixed(4));
      if (this.chart.data.labels.length > 80) {
        this.chart.data.labels.shift();
        this.chart.data.datasets[0].data.shift();
      }
      this.chart.update('none');
    }

    this.updateStats();
    this.drawCell();

    // Dead battery check
    if (Eclipped <= 0.001 || s.anodeMass <= 0) {
      s.running = false;
      const btn = document.getElementById('u9c-btn-start');
      btn.textContent = '\u25B6 START';
      btn.style.background = 'var(--gold)';
      document.getElementById('u9c-status').innerHTML =
        '<span style="color:#E74C3C;">\u26A0</span> Cell is dead &mdash; equilibrium reached (Q \u2248 K) or anode fully consumed. Press RESET to start over.';
      return;
    }

    // Schedule next tick: 100ms real time
    setTimeout(() => this.tick(), 100);
  },

