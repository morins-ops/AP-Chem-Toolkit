    // Cathode label below beaker
    ctx.fillStyle = '#E74C3C'; ctx.font = 'bold 11px Roboto'; ctx.textAlign = 'center';
    ctx.fillText('CATHODE (+)', rx + cellW / 2, cellY + cellH + 16);
