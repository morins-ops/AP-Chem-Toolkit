      }
      rxn.species.reactants.forEach(s => { if (!this.isExcludedFromK(s.name)) this.concentrations[s.name] = Math.max(0.001, this.concentrations[s.name] - s.coeff * xi); });
      rxn.species.products.forEach(s => { if (!this.isExcludedFromK(s.name)) this.concentrations[s.name] = Math.max(0.001, this.concentrations[s.name] + s.coeff * xi); });
    }
    this.timeLabels.push(parseFloat(this.simTime.toFixed(2)));
    this.getAllSpecies().forEach(s => { if (!this.timeSeriesData[s]) this.timeSeriesData[s] = []; this.timeSeriesData[s].push(this.concentrations[s]); });
    if (this.timeLabels.length > this.MAX_POINTS) {
      const trim = this.timeLabels.length - this.MAX_POINTS;
      this.timeLabels.splice(0, trim);
      this.getAllSpecies().forEach(s => { this.timeSeriesData[s].splice(0, trim); });
      const earliest = this.timeLabels[0];
      this.perturbationMarkers = this.perturbationMarkers.filter(m => m.time >= earliest);
    }
    const newQ = this.calculateQ();
    const deltaQ = K ? Math.abs(newQ - K) : 0;
    this.el('simTime').textContent = this.simTime.toFixed(1) + ' s';
    this.el('simDeltaQ').textContent = deltaQ.toFixed(4);
    const atEq = K ? (deltaQ / K < 0.008) : false;
    if (atEq) { this.setStatusDisplay('equilibrium'); this.el('simStatus').textContent = 'Equilibrium \u2713'; }
    else { this.setStatusDisplay('running'); this.el('simStatus').textContent = 'Shifting...'; }
    if (this.timeLabels.length % 2 === 0 || atEq) this.updateCharts();
    this.updateConcentrationTable(); this.updateQK(); this.updateRateArrows();
  },
  simpleKineticStep(scaledDt) {
    const rxn = this.currentReaction;
    let reactantProduct = 1;
    rxn.species.reactants.forEach(s => { if (!this.isExcludedFromK(s.name)) reactantProduct *= Math.pow(this.concentrations[s.name], s.coeff); });
    let productProduct = 1;
    rxn.species.products.forEach(s => { if (!this.isExcludedFromK(s.name)) productProduct *= Math.pow(this.concentrations[s.name], s.coeff); });
    const targetK = 0.6;
    const Q = productProduct / Math.max(reactantProduct, 0.0001);
    const deviation = Q / targetK - 1;
    let xi = -deviation * rxn.kf * scaledDt;
    if (xi > 0) {
      let maxXi = Infinity;
      rxn.species.reactants.forEach(s => { if (!this.isExcludedFromK(s.name)) maxXi = Math.min(maxXi, (this.concentrations[s.name] - 0.001) / s.coeff); });
      xi = Math.min(xi, Math.max(0, maxXi * 0.95));
    } else {
      let maxXi = Infinity;
      rxn.species.products.forEach(s => { if (!this.isExcludedFromK(s.name)) maxXi = Math.min(maxXi, (this.concentrations[s.name] - 0.001) / s.coeff); });
      xi = Math.max(xi, -Math.max(0, maxXi * 0.95));
    }
    rxn.species.reactants.forEach(s => { if (!this.isExcludedFromK(s.name)) this.concentrations[s.name] = Math.max(0.001, this.concentrations[s.name] - s.coeff * xi); });
    rxn.species.products.forEach(s => { if (!this.isExcludedFromK(s.name)) this.concentrations[s.name] = Math.max(0.001, this.concentrations[s.name] + s.coeff * xi); });
  },

  // ===== PERTURBATION =====
  perturbSystem(type, detail) {
    if (!this.currentReaction) return;
    if (!this.simRunning) {
      this.startSimulation();
      setTimeout(() => this.executePerturbOrChallenge(type, detail), 300);
      return;
    }
    this.executePerturbOrChallenge(type, detail);
  },
  executePerturbOrChallenge(type, detail) {
    if (this.mode === 'challenge' && !this.awaitingAnswer) {
      this.pendingPerturbation = { type, detail };
      this.pauseSimulation();
      this.showChallengeQuestion(type, detail);
      return;
    }
    if (this.awaitingAnswer) return;
    this.executePerturbation(type, detail);
  },
  executePerturbation(type, detail) {
    let actionText = '', markerColor = _tg();
    if (type === 'add') {
      const addAmount = Math.max(0.3, this.concentrations[detail] * 0.5);
      this.concentrations[detail] += addAmount;
      actionText = `+ ${detail} (+${addAmount.toFixed(2)} M)`; markerColor = '#58D68D';
      this.showPerturbExplanation('add', detail);
    } else if (type === 'remove') {
      const removeAmount = this.concentrations[detail] * 0.4;
      this.concentrations[detail] = Math.max(0.01, this.concentrations[detail] - removeAmount);
      actionText = `\u2212 ${detail} (\u2212${removeAmount.toFixed(2)} M)`; markerColor = '#E74C3C';
      this.showPerturbExplanation('remove', detail);
    } else if (type === 'temp') {
      actionText = detail === 'increase' ? '\uD83D\uDD25 Temp \u2191' : '\u2744\uFE0F Temp \u2193';
      markerColor = detail === 'increase' ? '#E74C3C' : '#5DADE2';
      this.applyTemperatureChange(detail); this.showTempExplanation(detail);
    } else if (type === 'pressure') {
      if (!this.currentReaction.gasPhase) { this.showExplanation('No Effect', 'Pressure changes have negligible effect on aqueous reactions.'); return; }
      actionText = detail === 'increase' ? 'P \u2191 (V \u2193)' : 'P \u2193 (V \u2191)'; markerColor = '#9B2F3E';
      this.applyPressureChange(detail); this.showPressureExplanation(detail);
    }
    this.perturbationMarkers.push({ time: parseFloat(this.simTime.toFixed(2)), label: actionText, color: markerColor });
    this.addHistoryEntry(actionText, '');
    this.updateCharts(); this.updateConcentrationTable(); this.updateQK();
    this.el('eqDisplay').classList.remove('shift-flash');
    void this.el('eqDisplay').offsetWidth;
    this.el('eqDisplay').classList.add('shift-flash');
  },
  applyTemperatureChange(detail) {
    const rxn = this.currentReaction;
    if (rxn.Keq !== null) {
      if (rxn.type === 'exo') rxn.Keq *= (detail === 'increase' ? 0.6 : 1.5);
      else rxn.Keq *= (detail === 'increase' ? 1.5 : 0.6);
    }
  },
  applyPressureChange(detail) {
    const factor = detail === 'increase' ? 1.3 : 0.75;
    this.getAllSpecies().forEach(name => {
      const info = this.getSpeciesInfo(name);
      if (info.phase === 'g') this.concentrations[name] *= factor;
    });
  },

  // ===== EXPLANATIONS =====
  showPerturbExplanation(action, species) {
    const info = this.getSpeciesInfo(species);
    const verb = action === 'add' ? 'Adding' : 'Removing';
    const dir = (action === 'add' && info.side === 'reactant') || (action === 'remove' && info.side === 'product')
      ? 'toward products (\u2192)' : 'toward reactants (\u2190)';
    this.showExplanation(`${verb} ${species}`,
      `<strong>${verb} ${species}</strong> (a ${info.side}) changes its concentration.<br><br>` +
      `Le Chatelier's Principle: the system will shift <span class="highlight">${dir}</span> to counteract this stress.` +
      `<div class="math">Q changes \u2192 Q \u2260 K<br>System shifts until Q = K again</div>` +
      `Watch the concentrations adjust in real time as the system re-establishes equilibrium!`
    );
  },
  showTempExplanation(detail) {
    const rxn = this.currentReaction;
    const isExo = rxn.type === 'exo';
    const dir = (detail === 'increase' && isExo) || (detail === 'decrease' && !isExo) ? 'toward reactants (\u2190)' : 'toward products (\u2192)';
    this.showExplanation(detail === 'increase' ? '\uD83D\uDD25 Temp \u2191' : '\u2744\uFE0F Temp \u2193',
      `<strong>${detail === 'increase' ? 'Increasing' : 'Decreasing'} temperature</strong>.<br><br>` +
      `This ${isExo ? 'exothermic' : 'endothermic'} reaction (\u0394H = ${rxn.deltaH > 0 ? '+' : ''}${rxn.deltaH} kJ/mol): think of heat as a ${isExo ? 'product' : 'reactant'}.` +
      `<div class="math">${isExo ? rxn.equation + ' + heat' : 'heat + ' + rxn.equation}</div>` +
      `The system shifts <span class="highlight">${dir}</span>.` +
      `<div class="math">Temperature changes K itself!<br>New K = ${rxn.Keq ? rxn.Keq.toFixed(3) : '\u2014'}</div>` +
      `<strong>Key AP concept:</strong> Temperature is the ONLY stress that changes K.`
    );
  },
  showPressureExplanation(detail) {
    const rxn = this.currentReaction;
    const mR = rxn.molesReactant, mP = rxn.molesProduct;
    let shiftInfo = '';
    if (mR === mP) {
      shiftInfo = 'Equal gas moles on both sides \u2192 <strong>no net shift</strong> (but watch concentrations change momentarily).';
    } else {
      const fewer = mP < mR ? 'products' : 'reactants';
      const dir = detail === 'increase' ? (mP < mR ? '\u2192 products' : '\u2190 reactants') : (mP > mR ? '\u2192 products' : '\u2190 reactants');
      shiftInfo = `System shifts <span class="highlight">${dir}</span> toward fewer gas moles (${fewer}).`;
    }
    this.showExplanation(`Pressure ${detail === 'increase' ? '\u2191' : '\u2193'}`,
      `<strong>${detail === 'increase' ? 'Increasing' : 'Decreasing'} pressure</strong> (${detail === 'increase' ? 'decreasing' : 'increasing'} volume).<br><br>` +
      `All gas concentrations ${detail === 'increase' ? 'increase' : 'decrease'} proportionally.` +
      `<div class="math">Reactant gas moles: ${mR}<br>Product gas moles: ${mP}</div>${shiftInfo}` +
      `<div class="math">Pressure changes do NOT change K<br>Only Q changes \u2192 system adjusts</div>`
    );
  },
  showExplanation(title, html) {
    const box = this.el('explanationBox');
    box.innerHTML = `<div class="exp-title">${title}</div>${html}`;
  },

  // ===== CHALLENGE MODE =====
  showChallengeQuestion(type, detail) {
    this.awaitingAnswer = true;
    this.el('challengeBox').style.display = 'block';
    const shift = this.predictShift(type, detail);
    let questionText = '';
    if (type === 'add') {
      const info = this.getSpeciesInfo(detail);
      questionText = `If you <strong>add ${detail}</strong> (a ${info.side}), which direction will equilibrium shift?`;
    } else if (type === 'remove') {
      const info = this.getSpeciesInfo(detail);
      questionText = `If you <strong>remove ${detail}</strong> (a ${info.side}), which direction will equilibrium shift?`;
    } else if (type === 'temp') {
      questionText = `If you <strong>${detail === 'increase' ? 'increase' : 'decrease'} temperature</strong> for this ${this.currentReaction.type === 'exo' ? 'exothermic' : 'endothermic'} reaction, which direction?`;
    } else if (type === 'pressure') {
      questionText = `If you <strong>${detail === 'increase' ? 'increase pressure' : 'decrease pressure'}</strong>, which direction?`;
    }
    this.el('challengeQ').innerHTML = questionText;
    this.el('challengeOpts').innerHTML = [
      { text:'\u2192 Shift RIGHT (products)', value:'right' },
      { text:'\u2190 Shift LEFT (reactants)', value:'left' },
      { text:'\u21D4 No shift', value:'none' }
    ].map(o => `<button class="challenge-opt" onclick="U7C.submitAnswer('${o.value}','${shift}','${type}','${detail}')">${o.text}</button>`).join('');
    this.el('challengeFeedback').className = 'challenge-feedback';
  },
  predictShift(type, detail) {
    if (type === 'add') return this.getSpeciesInfo(detail).side === 'reactant' ? 'right' : 'left';
    if (type === 'remove') return this.getSpeciesInfo(detail).side === 'reactant' ? 'left' : 'right';
    if (type === 'temp') {
      if (this.currentReaction.type === 'exo') return detail === 'increase' ? 'left' : 'right';
      return detail === 'increase' ? 'right' : 'left';
    }
    if (type === 'pressure') {
      if (!this.currentReaction.gasPhase) return 'none';
      const mR = this.currentReaction.molesReactant, mP = this.currentReaction.molesProduct;
      if (mR === mP) return 'none';
      if (detail === 'increase') return mP < mR ? 'right' : 'left';
      return mP > mR ? 'right' : 'left';
    }
    return 'none';
  },
  submitAnswer(selected, correct, type, detail) {
    const isCorrect = selected === correct;
    this.score.total++;
    if (isCorrect) { this.score.correct++; this.score.streak++; } else { this.score.streak = 0; }
    document.querySelectorAll('#u7-lechatelier .challenge-opt').forEach(btn => {
      btn.disabled = true;
      if (btn.textContent.toLowerCase().includes(correct)) btn.classList.add('correct');
      if (btn.textContent.toLowerCase().includes(selected) && !isCorrect) btn.classList.add('incorrect');
    });
    const fb = this.el('challengeFeedback');
    const dirMap = { right:'\u2192 products', left:'\u2190 reactants', none:'no shift' };
    if (isCorrect) {
      fb.className = 'challenge-feedback show correct-fb';
      fb.innerHTML = `<strong>Correct! \uD83C\uDF89</strong> Watch the system shift ${dirMap[correct]} in real time!`;
    } else {
      fb.className = 'challenge-feedback show incorrect-fb';
      fb.innerHTML = `<strong>Not quite.</strong> The correct answer is: <strong>${dirMap[correct]}</strong>. Watch and learn!`;
    }
    this.el('correctScore').textContent = this.score.correct;
    this.el('totalScore').textContent = this.score.total;
    this.el('streakText').textContent = this.score.streak >= 2 ? `\uD83D\uDD25 ${this.score.streak} streak!` : '';
    this.awaitingAnswer = false;
    setTimeout(() => {
      this.executePerturbation(type, detail);
      this.pendingPerturbation = null;
      this.resumeSimulation();
      setTimeout(() => { this.el('challengeBox').style.display = 'none'; }, 4000);
    }, 1500);
  },

  // ===== Q vs K =====
  calculateQ() {
    if (!this.currentReaction) return 0;
    let num = 1, den = 1;
    this.currentReaction.species.products.forEach(s => { if (s.phase !== 'l' && s.phase !== 's') num *= Math.pow(Math.max(this.concentrations[s.name], 0.0001), s.coeff); });
    this.currentReaction.species.reactants.forEach(s => { if (s.phase !== 'l' && s.phase !== 's') den *= Math.pow(Math.max(this.concentrations[s.name], 0.0001), s.coeff); });
    return den === 0 ? Infinity : num / den;
  },
  updateQK() {
    const K = this.currentReaction ? this.currentReaction.Keq : null;
    if (!this.currentReaction || K === null) {
      this.el('qValue').textContent = '\u2014'; this.el('kValue').textContent = '\u2014';
      this.el('qkCompare').textContent = '\u2014'; this.el('qkCompare').className = 'qk-comparison eq';
      this.el('shiftArrow').textContent = 'K not directly shown'; this.el('shiftArrow').className = 'shift-arrow none';
      return;
    }
    const Q = this.calculateQ();
    this.el('qValue').textContent = Q.toFixed(3);
    this.el('kValue').textContent = K.toFixed(3);
    const comp = this.el('qkCompare'), arrow = this.el('shiftArrow');
    const tolerance = K * 0.008;
    if (Math.abs(Q - K) < tolerance + 0.005) {
      comp.textContent = '\u2248'; comp.className = 'qk-comparison eq';
      arrow.textContent = '\u21D4 AT EQUILIBRIUM'; arrow.className = 'shift-arrow none';
    } else if (Q > K) {
      comp.textContent = '>'; comp.className = 'qk-comparison gt';
      arrow.textContent = '\u27F5 SHIFT LEFT (Q > K)'; arrow.className = 'shift-arrow left';
    } else {
      comp.textContent = '<'; comp.className = 'qk-comparison lt';
      arrow.textContent = 'SHIFT RIGHT (Q < K) \u27F6'; arrow.className = 'shift-arrow right';
    }
  },

  // ===== RATE ARROWS =====
  updateRateArrows() {
    const container = this.el('rateArrowsContainer');
    if (!this.currentReaction) { container.style.display = 'none'; return; }
    container.style.display = 'flex';
    const rxn = this.currentReaction, K = rxn.Keq;
    let forwardProduct = 1;
    rxn.species.reactants.forEach(s => { if (!this.isExcludedFromK(s.name)) forwardProduct *= Math.pow(Math.max(this.concentrations[s.name], 0.0001), s.coeff); });
    const forwardRate = rxn.kf * forwardProduct;
    let reverseProduct = 1;
    rxn.species.products.forEach(s => { if (!this.isExcludedFromK(s.name)) reverseProduct *= Math.pow(Math.max(this.concentrations[s.name], 0.0001), s.coeff); });
    const kr = (K && K > 0) ? rxn.kf / K : rxn.kf;
    const reverseRate = kr * reverseProduct;
    const MAX_WIDTH = 260, MIN_WIDTH = 10;
    const maxRate = Math.max(forwardRate, reverseRate, 0.0001);
    this.el('forwardShaft').style.width = Math.max(MIN_WIDTH, (forwardRate / maxRate) * MAX_WIDTH) + 'px';
    this.el('reverseShaft').style.width = Math.max(MIN_WIDTH, (reverseRate / maxRate) * MAX_WIDTH) + 'px';
    this.el('forwardRateValue').textContent = forwardRate.toFixed(4) + ' M/s';
    this.el('reverseRateValue').textContent = reverseRate.toFixed(4) + ' M/s';
    this.el('rateEquation').textContent = rxn.equation;
  },

  // ===== CONCENTRATION TABLE =====
  updateConcentrationTable() {
    this.el('concBody').innerHTML = this.getAllSpecies().map(name => {
      if (this.isExcludedFromK(name)) return '';
      return `<tr><td class="species-name">${name}</td><td class="conc-val">${this.concentrations[name].toFixed(4)}</td></tr>`;
    }).join('');
  },

  // ===== STATUS DISPLAY =====
  setStatusDisplay(state) {
    const el = this.el('eqStatus'), txt = this.el('statusText');
    if (state === 'equilibrium') { el.className = 'eq-status equilibrium'; txt.textContent = 'At Equilibrium \u2713'; }
    else if (state === 'running') { el.className = 'eq-status shifting'; txt.textContent = 'Shifting...'; }
    else if (state === 'paused') { el.className = 'eq-status paused'; txt.textContent = 'Paused'; }
    else { el.className = 'eq-status paused'; txt.textContent = 'Ready'; }
  },
  updateReactionDetails() {
    this.el('reactionDetails').innerHTML = `<strong>${this.currentReaction.name}</strong><br>${this.currentReaction.description}`;
  },

  // ===== CHARTS =====
  initCharts() {
    Chart.defaults.color = '#B8B0A0';
    Chart.defaults.font.family = 'Roboto';
    this.barChart = new Chart(this.el('barChart').getContext('2d'), {
      type: 'bar',
      data: { labels: [], datasets: [{ data: [], backgroundColor: [] }] },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false }, datalabels: { anchor:'end', align:'top', color:'#F5F0E8', font:{ size:10, weight:'bold', family:'Courier New' }, formatter: v => v.toFixed(3) } },
        scales: {
          x: { grid:{ color:'rgba(205,163,73,0.08)' }, ticks:{ font:{ size:10, weight:'500' } } },
          y: { beginAtZero:true, grid:{ color:'rgba(205,163,73,0.08)' }, title:{ display:true, text:'Conc (M)', color:'#B8B0A0', font:{ size:10 } } }
        },
        animation: { duration: 100 }
      },
      plugins: [ChartDataLabels]
    });
    this.lineChart = new Chart(this.el('lineChart').getContext('2d'), {
      type: 'line',
      data: { labels: [], datasets: [] },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend:{ position:'bottom', labels:{ usePointStyle:true, pointStyle:'circle', padding:10, font:{ size:9 } } }, datalabels:{ display:false }, annotation:{ annotations:{} } },
        scales: {
          x: { type:'linear', grid:{ color:'rgba(205,163,73,0.08)' }, title:{ display:true, text:'Time (s)', color:'#B8B0A0', font:{ size:9 } }, ticks:{ maxTicksLimit:8, font:{ size:8 } } },
          y: { beginAtZero:true, grid:{ color:'rgba(205,163,73,0.08)' }, title:{ display:true, text:'Conc (M)', color:'#B8B0A0', font:{ size:9 } } }
        },
        animation: { duration: 0 },
        elements: { point:{ radius:0 }, line:{ borderWidth:2 } }
      },
      plugins: [ChartDataLabels]
    });
  },
  updateCharts() {
    if (!this.currentReaction) return;
    const species = this.getEditableSpecies();
    const allInfo = species.map(s => this.currentReaction.species.reactants.find(x => x.name === s) || this.currentReaction.species.products.find(x => x.name === s));
    this.barChart.data.labels = species;
    this.barChart.data.datasets[0].data = species.map(s => this.concentrations[s]);
    this.barChart.data.datasets[0].backgroundColor = allInfo.map(s => s.color);
    this.barChart.data.datasets[0].borderColor = allInfo.map(s => s.color);
    this.barChart.data.datasets[0].borderWidth = 1;
    this.barChart.data.datasets[0].borderRadius = 6;
    this.barChart.update('none');
    this.lineChart.data.labels = this.timeLabels;
    this.lineChart.data.datasets = species.map((name, idx) => ({
      label: name, data: this.timeSeriesData[name] || [],
      borderColor: allInfo[idx].color, backgroundColor: allInfo[idx].color + '22',
      borderWidth: 2, tension: 0.2, fill: false
    }));
    const annotations = {};
    this.perturbationMarkers.forEach((m, i) => {
      annotations['marker' + i] = {
        type:'line', xMin:m.time, xMax:m.time, borderColor:m.color, borderWidth:2, borderDash:[4,4],
        label: { display:true, content:m.label, position:'start', backgroundColor:m.color+'CC', color:'#FFF', font:{ size:9, weight:'bold' }, padding:{ top:2,bottom:2,left:4,right:4 }, borderRadius:3 }
      };
    });
    this.lineChart.options.plugins.annotation.annotations = annotations;
    this.lineChart.update('none');
  },

  // ===== HISTORY =====
  addHistoryEntry(action) {
    this.actionHistory.unshift({ action, time: new Date().toLocaleTimeString(), simT: this.simTime.toFixed(1) });
    this.el('historyLog').innerHTML = this.actionHistory.slice(0, 15).map(h =>
      `<div class="history-entry"><span class="timestamp">${h.time} (t=${h.simT}s)</span><br><span class="action">${h.action}</span></div>`
    ).join('');
  }
};



const U7D = {

  salts: [

    {name:'AgCl',eq:'AgCl ⇌ Ag⁺ + Cl⁻',Ksp:1.8e-10,ions:['Ag⁺','Cl⁻'],stoich:[1,1],ci:'Cl⁻'},

    {name:'PbI₂',eq:'PbI₂ ⇌ Pb²⁺ + 2I⁻',Ksp:9.8e-9,ions:['Pb²⁺','I⁻'],stoich:[1,2],ci:'I⁻'},

    {name:'CaF₂',eq:'CaF₂ ⇌ Ca²⁺ + 2F⁻',Ksp:3.5e-11,ions:['Ca²⁺','F⁻'],stoich:[1,2],ci:'F⁻'},

    {name:'BaSO₄',eq:'BaSO₄ ⇌ Ba²⁺ + SO₄²⁻',Ksp:1.1e-10,ions:['Ba²⁺','SO₄²⁻'],stoich:[1,1],ci:'SO₄²⁻'},

    {name:'Mg(OH)₂',eq:'Mg(OH)₂ ⇌ Mg²⁺ + 2OH⁻',Ksp:5.6e-12,ions:['Mg²⁺','OH⁻'],stoich:[1,2],ci:'OH⁻'}

  ],

  update() {

    const s = this.salts[+document.getElementById('u7d-salt').value];

    const ci = +document.getElementById('u7d-ci').value;

    document.getElementById('u7d-ci-val').textContent = ci.toFixed(3);

    // Solve for molar solubility

    let sol;

    if (s.stoich[1] === 1) { sol = ci > 0 ? s.Ksp / (ci) : Math.sqrt(s.Ksp); }

    else { // 1:2 stoichiometry: Ksp = s(2s+ci)²

      if (ci > 0) { sol = s.Ksp / (ci * ci); } // approximation when ci >> 2s

      else { sol = Math.pow(s.Ksp / 4, 1/3); }

    }

    const solNoCi = s.stoich[1]===1 ? Math.sqrt(s.Ksp) : Math.pow(s.Ksp/4,1/3);

    document.getElementById('u7d-calc').innerHTML = `

      <strong>${s.eq}</strong><br>Ksp = ${s.Ksp.toExponential(1)}<br><br>

      <strong>Molar Solubility:</strong><br>

      Without common ion: <span style="color:var(--gold)">${solNoCi.toExponential(3)} M</span><br>

