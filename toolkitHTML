    if (this.compChart) {
      this.compChart.data.labels = labels;
      this.compChart.data.datasets[0].data = data;
      this.compChart.data.datasets[0].backgroundColor = colors;
      this.compChart.update();
    }
    this.update();
  },
  init() {
    const ctx = document.getElementById('u1a-comp-chart').getContext('2d');
    this.compChart = new Chart(ctx, {
      type: 'doughnut',
      data: {
