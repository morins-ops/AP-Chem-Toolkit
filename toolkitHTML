    {name:'H₂SO₄',type:'strong acid',Ka:1e7},

    {name:'HF',type:'weak acid',Ka:6.8e-4}

  ],

  update() {

    const s = this.species[+document.getElementById('u8a-species').value];

    const c = +document.getElementById('u8a-conc').value;

    document.getElementById('u8a-c-val').textContent = c.toFixed(3);

    let pH, H, OH;

    if(s.type==='strong acid'){H=c;pH=-Math.log10(H);}

    else if(s.type==='weak acid'){H=Math.sqrt(s.Ka*c);pH=-Math.log10(H);}

    else if(s.type==='strong base'){OH=c;pH=14+Math.log10(OH);}

    else{OH=Math.sqrt(s.Kb*c);pH=14+Math.log10(OH);}

    H = Math.pow(10,-pH); OH = 1e-14/H;

    document.getElementById('u8a-calc').innerHTML = `

      <strong>${s.name} (${s.type})</strong><br>Concentration: ${c.toFixed(3)} M<br><br>

      <strong style="color:var(--gold)">pH = ${pH.toFixed(2)}</strong><br>

      pOH = ${(14-pH).toFixed(2)}<br>

      [H⁺] = ${H.toExponential(2)} M<br>

      [OH⁻] = ${OH.toExponential(2)} M<br>

      ${s.type.includes('weak')?`<br>Ka = ${s.Ka||'N/A'} | Kb = ${s.Kb||'N/A'}<br>% ionization = ${((s.type==='weak acid'?H/c:OH/c)*100).toFixed(2)}%`:'(100% dissociation)'}`;

