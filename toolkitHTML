  drawStatic(r) {
    const c = document.getElementById('u4c-canvas');
    if (!c) return;
    const ctx = c.getContext('2d');
    const W = c.width, H = c.height;
    ctx.clearRect(0,0,W,H);

    ctx.fillStyle = _tg(); ctx.font = 'bold 14px Roboto'; ctx.textAlign = 'center';
    ctx.fillText('Electron Transfer Diagram', W/2, 25);

    const numSpecies = r.species.length;
    const spacing = W / (numSpecies + 1);

    r.species.forEach((s, si) => {
      const cx = spacing * (si + 1);
      const topY = 70, botY = 260;

      ctx.beginPath(); ctx.arc(cx, topY, 35, 0, Math.PI*2);
      ctx.fillStyle = s.color + '33'; ctx.fill();
      ctx.strokeStyle = s.color; ctx.lineWidth = 2; ctx.stroke();
      ctx.fillStyle = '#fff'; ctx.font = 'bold 16px Roboto'; ctx.textAlign = 'center';
      ctx.fillText(s.name, cx, topY + 5);
      ctx.font = '11px Roboto'; ctx.fillStyle = s.color;
      ctx.fillText('Ox: ' + (s.oxBefore > 0 ? '+' : '') + s.oxBefore, cx, topY + 22);

      ctx.beginPath(); ctx.arc(cx, botY, 35, 0, Math.PI*2);
      ctx.fillStyle = s.color + '33'; ctx.fill();
      ctx.strokeStyle = s.color; ctx.lineWidth = 2; ctx.stroke();
      ctx.fillStyle = '#fff'; ctx.font = 'bold 16px Roboto';
      ctx.fillText(s.name, cx, botY + 5);
      ctx.font = '11px Roboto'; ctx.fillStyle = s.color;
      ctx.fillText('Ox: ' + (s.oxAfter > 0 ? '+' : '') + s.oxAfter, cx, botY + 22);

      const change = s.oxAfter - s.oxBefore;
      const isOx = change > 0;
      ctx.strokeStyle = isOx ? '#ff6666' : '#66ff66';
      ctx.lineWidth = 2;
      ctx.beginPath(); ctx.moveTo(cx, topY + 40); ctx.lineTo(cx, botY - 40); ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(cx-6, botY-48); ctx.lineTo(cx, botY-40); ctx.lineTo(cx+6, botY-48);
      ctx.fillStyle = isOx ? '#ff6666' : '#66ff66'; ctx.fill();

      const eCount = Math.abs(change);
      ctx.fillStyle = '#fff'; ctx.font = 'bold 11px Roboto';
      ctx.fillText(isOx ? '\u2212' + eCount + 'e\u207b' : '+' + eCount + 'e\u207b', cx + 30, (topY + botY)/2);
      ctx.font = '10px Roboto';
      ctx.fillStyle = isOx ? '#ff8888' : '#88ff88';
      ctx.fillText(isOx ? 'OXIDIZED' : 'REDUCED', cx, (topY+botY)/2 + 15);
    });

    ctx.fillStyle = '#888'; ctx.font = '11px Roboto'; ctx.textAlign = 'center';
    ctx.fillText('BEFORE', W/2, 50);
    ctx.fillText('AFTER', W/2, 310);
    ctx.fillStyle = '#555'; ctx.font = '10px Roboto';
    ctx.fillText('OIL RIG: Oxidation Is Loss \u2022 Reduction Is Gain', W/2, H - 15);

    return {spacing, numSpecies};
  },

  animateElectrons() {
    const r = this.currentRedoxRxn;
    if (!r) return;
    const info = this.drawStatic(r);
    if (!info) return;

    const c = document.getElementById('u4c-canvas');
    if (!c) return;
    const ctx = c.getContext('2d');
    const W = c.width;
    const {spacing} = info;

    // Find oxidized and reduced species positions
    const ox = r.species.find(s => s.oxAfter > s.oxBefore);
    const red = r.species.find(s => s.oxAfter < s.oxBefore);
    if (ox && red) {
      const oxX = spacing * (r.species.indexOf(ox) + 1);
      const redX = spacing * (r.species.indexOf(red) + 1);
      const midY = 165;

      // Draw dashed transfer path
      ctx.strokeStyle = 'rgba(205,163,73,0.4)'; ctx.lineWidth = 2;
      ctx.setLineDash([6,4]);
      ctx.beginPath();
      ctx.moveTo(oxX, midY - 20);
      ctx.quadraticCurveTo((oxX+redX)/2, midY - 60, redX, midY - 20);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = _tg(); ctx.font = 'bold 11px Roboto'; ctx.textAlign = 'center';
      ctx.fillText(r.totalE + 'e\u207b transferred', (oxX+redX)/2, midY - 55);

      // Animate electron dots along the curve
      const numDots = Math.min(r.totalE, 5);
      for (let i = 0; i < numDots; i++) {
        const t = ((this.animT / 120) + i / numDots) % 1;
        // Quadratic bezier point
        const p0x = oxX, p0y = midY - 20;
        const p1x = (oxX+redX)/2, p1y = midY - 60;
        const p2x = redX, p2y = midY - 20;
        const x = (1-t)*(1-t)*p0x + 2*(1-t)*t*p1x + t*t*p2x;
        const y = (1-t)*(1-t)*p0y + 2*(1-t)*t*p1y + t*t*p2y;
        // Glow effect
        ctx.beginPath(); ctx.arc(x, y, 6, 0, Math.PI*2);
        ctx.fillStyle = 'rgba(205,163,73,0.3)'; ctx.fill();
        ctx.beginPath(); ctx.arc(x, y, 3.5, 0, Math.PI*2);
        ctx.fillStyle = _tg(); ctx.fill();
        // e- label on first dot
        if (i === 0) {
          ctx.fillStyle = '#fff'; ctx.font = 'bold 7px Roboto'; ctx.textAlign = 'center';
          ctx.fillText('e\u207b', x, y + 2.5);
        }
      }
    }

