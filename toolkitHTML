// --- Unit 2A: Bond Energy Curve ---

const U2A = {

  bonds: {
    hcl: { name: 'H-Cl', bondLen: 127, bondE: 431, den: 0.96, type: 'Polar Covalent', atoms: ['H','Cl'], color: '#E74C3C' },
    hh: { name: 'H-H', bondLen: 74, bondE: 436, den: 0.0, type: 'Nonpolar Covalent', atoms: ['H','H'], color: '#3498DB' },
    oo: { name: 'O=O', bondLen: 121, bondE: 498, den: 0.0, type: 'Nonpolar Covalent', atoms: ['O','O'], color: '#2ECC71' },
    nn: { name: 'N\u2261N', bondLen: 110, bondE: 945, den: 0.0, type: 'Nonpolar Covalent', atoms: ['N','N'], color: '#9B59B6' },
    nacl: { name: 'Na-Cl', bondLen: 236, bondE: 787, den: 2.23, type: 'Ionic', atoms: ['Na','Cl'], color: '#E67E22' },
    ff: { name: 'F-F', bondLen: 142, bondE: 159, den: 0.0, type: 'Nonpolar Covalent', atoms: ['F','F'], color: '#1ABC9C' }
  },

  // Fixed scale constants — same for ALL bonds
  MAX_DE: 945,    // N≡N has highest bond energy
  MAX_DIST: 400,  // pm
  MIN_DIST: 20,   // pm

  update() {
    const b = this.bonds[document.getElementById('u2a-bond').value];
    document.getElementById('u2a-bl').textContent = b.bondLen;
    document.getElementById('u2a-be').textContent = b.bondE;
    document.getElementById('u2a-type').textContent = b.type;
    document.getElementById('u2a-den').textContent = b.den.toFixed(2);
    document.getElementById('u2a-dist').value = b.bondLen;
    document.getElementById('u2a-dist-val').textContent = b.bondLen + ' pm';
    this.draw();
  },

  updateDist() {
    const d = parseInt(document.getElementById('u2a-dist').value);
    document.getElementById('u2a-dist-val').textContent = d + ' pm';
    this.draw();
  },

  draw() {
    const canvas = document.getElementById('u2a-pe-canvas');
    const ctx = canvas.getContext('2d');
    const W = canvas.width, H = canvas.height;
    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#FAFAFA'; ctx.fillRect(0, 0, W, H);

    const padL = 55, padR = 20, padT = 25, padB = 40;
    const pW = W - padL - padR, pH = H - padT - padB;

    // FIXED scale: zero line at 25% from top, well depth scaled to MAX_DE
    const zeroY = padT + pH * 0.22;
    const maxRepulsive = this.MAX_DE * 0.4;
    const fixedScale = (pH * 0.72) / (this.MAX_DE + maxRepulsive);

    function dToX(d) { return padL + ((d - 20) / 380) * pW; }
    function peToY(pe) { return zeroY - pe * fixedScale; }

    // Axes
    ctx.strokeStyle = '#333'; ctx.lineWidth = 1.5;
    ctx.beginPath(); ctx.moveTo(padL, padT); ctx.lineTo(padL, padT + pH); ctx.lineTo(padL + pW, padT + pH); ctx.stroke();

    // Zero line (PE = 0)
    ctx.strokeStyle = '#AAA'; ctx.lineWidth = 0.5; ctx.setLineDash([4,4]);
    ctx.beginPath(); ctx.moveTo(padL, zeroY); ctx.lineTo(padL + pW, zeroY); ctx.stroke();
    ctx.setLineDash([]);
    ctx.fillStyle = '#888'; ctx.font = '9px Arial'; ctx.textAlign = 'right';
    ctx.fillText('PE = 0', padL - 5, zeroY + 3);

    // Y-axis tick marks for reference (every 200 kJ/mol)
    ctx.fillStyle = '#AAA'; ctx.font = '8px Arial'; ctx.textAlign = 'right';
    for (let tick = -800; tick <= 400; tick += 200) {
      if (tick === 0) continue;
      const ty = peToY(tick);
      if (ty > padT && ty < padT + pH) {
        ctx.strokeStyle = '#DDD'; ctx.lineWidth = 0.3; ctx.setLineDash([2,3]);
        ctx.beginPath(); ctx.moveTo(padL, ty); ctx.lineTo(padL + pW, ty); ctx.stroke();
        ctx.setLineDash([]);
        ctx.fillStyle = '#AAA';
        ctx.fillText(tick, padL - 5, ty + 3);
      }
    }

    // Get primary bond
    const bKey = document.getElementById('u2a-bond').value;
    const b = this.bonds[bKey];

    // Get compare bond (if any)
    const cmpEl = document.getElementById('u2a-compare');
    const cmpKey = cmpEl ? cmpEl.value : 'none';
    const b2 = (cmpKey !== 'none' && cmpKey !== bKey) ? this.bonds[cmpKey] : null;

    // Helper: compute Morse PE at distance d for a bond
    function morsePE(d, bond) {
      const re = bond.bondLen, De = bond.bondE;
      const a = 2.5 / re * 100;
      const exp_val = Math.exp(-a * (d - re));
      let pe = De * (Math.pow(1 - exp_val, 2) - 1);
      if (d < re * 0.35) pe = De * 3;
      pe = Math.min(pe, De * 2.5);
      return pe;
    }

    // Draw compare curve first (behind primary)
    if (b2) {
      ctx.beginPath();
      ctx.strokeStyle = b2.color; ctx.lineWidth = 2.5; ctx.globalAlpha = 0.5;
      let started = false;
      for (let d = 25; d <= 395; d += 1) {
        const pe = morsePE(d, b2);
        const px = dToX(d), py = peToY(pe);
        if (py > padT - 5 && py < padT + pH + 5) {
          if (!started) { ctx.moveTo(px, py); started = true; }
          else ctx.lineTo(px, py);
        }
      }
      ctx.stroke();
      ctx.globalAlpha = 1.0;

      // Compare equilibrium point
      const eqX2 = dToX(b2.bondLen), eqY2 = peToY(-b2.bondE);
      ctx.fillStyle = b2.color; ctx.beginPath(); ctx.arc(eqX2, eqY2, 4, 0, Math.PI*2); ctx.fill();
      // Label
      ctx.strokeStyle = b2.color; ctx.lineWidth = 1; ctx.setLineDash([3,3]);
      ctx.beginPath(); ctx.moveTo(eqX2, eqY2); ctx.lineTo(eqX2, padT + pH); ctx.stroke();
      ctx.setLineDash([]);
      ctx.fillStyle = b2.color; ctx.font = '9px Arial'; ctx.textAlign = 'center';
      ctx.fillText(b2.bondLen + ' pm', eqX2, padT + pH + 14);
    }

    // Draw primary curve
    ctx.beginPath();
    ctx.strokeStyle = b.color; ctx.lineWidth = 2.5;
    let started = false;
    for (let d = 25; d <= 395; d += 1) {
      const pe = morsePE(d, b);
      const px = dToX(d), py = peToY(pe);
      if (py > padT - 5 && py < padT + pH + 5) {
        if (!started) { ctx.moveTo(px, py); started = true; }
        else ctx.lineTo(px, py);
      }
    }
    ctx.stroke();

    // Mark equilibrium point
    const eqX = dToX(b.bondLen), eqY = peToY(-b.bondE);
    ctx.fillStyle = b.color; ctx.beginPath(); ctx.arc(eqX, eqY, 5, 0, Math.PI*2); ctx.fill();

    // Dashed lines to axes from eq point
    ctx.strokeStyle = b.color; ctx.lineWidth = 1; ctx.setLineDash([3,3]);
    ctx.beginPath(); ctx.moveTo(eqX, eqY); ctx.lineTo(eqX, padT + pH); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(eqX, eqY); ctx.lineTo(padL, eqY); ctx.stroke();
    ctx.setLineDash([]);

    // Bond energy annotation (double arrow)
    ctx.strokeStyle = '#7B1F2E'; ctx.lineWidth = 1.5;
    const arrowX = eqX + 25;
    ctx.beginPath(); ctx.moveTo(arrowX, zeroY); ctx.lineTo(arrowX, eqY); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(arrowX-4, zeroY+6); ctx.lineTo(arrowX, zeroY); ctx.lineTo(arrowX+4, zeroY+6); ctx.fillStyle='#7B1F2E'; ctx.fill();
    ctx.beginPath(); ctx.moveTo(arrowX-4, eqY-6); ctx.lineTo(arrowX, eqY); ctx.lineTo(arrowX+4, eqY-6); ctx.fillStyle='#7B1F2E'; ctx.fill();
    ctx.fillStyle = '#7B1F2E'; ctx.font = 'bold 10px Arial'; ctx.textAlign = 'left';
    ctx.fillText('Bond Energy', arrowX + 5, (zeroY + eqY)/2 - 4);
    ctx.fillText(b.bondE + ' kJ/mol', arrowX + 5, (zeroY + eqY)/2 + 9);

    // Primary bond length label
    ctx.fillStyle = b.color; ctx.font = '9px Arial'; ctx.textAlign = 'center';
    ctx.fillText(b.bondLen + ' pm', eqX, padT + pH + 14);
    if (!b2) ctx.fillText('Bond Length', eqX, padT + pH + 25);

    // Distance marker if sliding
    const markerDist = parseInt(document.getElementById('u2a-dist').value);
    if (markerDist !== b.bondLen) {
      const mx = dToX(markerDist);
      ctx.strokeStyle = 'rgba(93,173,226,0.7)'; ctx.lineWidth = 2; ctx.setLineDash([2,2]);
      ctx.beginPath(); ctx.moveTo(mx, padT); ctx.lineTo(mx, padT+pH); ctx.stroke();
      ctx.setLineDash([]);
    }

    // Legend (if comparing)
    if (b2) {
      const lgX = padL + pW - 130, lgY = padT + 8;
      ctx.fillStyle = 'rgba(255,255,255,0.85)';
      ctx.fillRect(lgX, lgY, 135, 38);
      ctx.strokeStyle = '#CCC'; ctx.lineWidth = 0.5;
      ctx.strokeRect(lgX, lgY, 135, 38);
      // Primary
      ctx.strokeStyle = b.color; ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.moveTo(lgX+6, lgY+12); ctx.lineTo(lgX+26, lgY+12); ctx.stroke();
      ctx.fillStyle = '#333'; ctx.font = '10px Arial'; ctx.textAlign = 'left';
      ctx.fillText(b.name + ' (' + b.bondE + ' kJ)', lgX+30, lgY+15);
      // Compare
      ctx.strokeStyle = b2.color; ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.moveTo(lgX+6, lgY+28); ctx.lineTo(lgX+26, lgY+28); ctx.stroke();
      ctx.fillText(b2.name + ' (' + b2.bondE + ' kJ)', lgX+30, lgY+31);
    }

    // Axis labels
    ctx.fillStyle = '#333'; ctx.font = 'bold 11px Arial'; ctx.textAlign = 'center';
    ctx.fillText('Internuclear Distance (pm)', padL + pW/2, H - 5);
    ctx.save(); ctx.translate(14, padT + pH/2); ctx.rotate(-Math.PI/2);
    ctx.fillText('Potential Energy (kJ/mol)', 0, 0); ctx.restore();
  },

  init() { this.update(); }

};



