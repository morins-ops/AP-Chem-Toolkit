  drawOrbitals(el) {

    const canvas = document.getElementById('u1c-orbital-canvas');

    const ctx = canvas.getContext('2d');

    ctx.clearRect(0, 0, canvas.width, canvas.height);



    const subshellOrder = ['1s', '2s', '2p', '3s', '3p', '4s', '3d', '4p'];

    const orbitalCounts = { s: 1, p: 3, d: 5 };

    const tc = getThemeColors();

    let x = 15, y = 30;

    const boxW = 22, boxH = 28, gap = 4, groupGap = 20;



    el.subshells.forEach(sub => {

      const type = sub.label.slice(-1);

      const numOrbitals = orbitalCounts[type] || 1;

      const totalElectrons = sub.e;



      // Label

      ctx.fillStyle = tc.gold;

      ctx.font = 'bold 10px Oswald';

      ctx.fillText(sub.label, x, y - 5);



      // Draw orbital boxes

      for (let o = 0; o < numOrbitals; o++) {

        const bx = x + o * (boxW + gap);

        ctx.strokeStyle = tc.isLight ? 'rgba(90,66,16,0.5)' : 'rgba(205,163,73,0.4)';

        ctx.lineWidth = 1;

        ctx.strokeRect(bx, y, boxW, boxH);



        // Fill electrons (Hund's rule: fill singly first, then pair)

        let eInThisOrbital = 0;

        if (totalElectrons > numOrbitals) {

          // Pairing phase

          const unpaired = Math.min(numOrbitals, totalElectrons);

          const paired = totalElectrons - numOrbitals;

          eInThisOrbital = o < paired ? 2 : (o < totalElectrons ? 1 : 0);

        } else {

          eInThisOrbital = o < totalElectrons ? 1 : 0;

        }



        // Draw arrows

        if (eInThisOrbital >= 1) {

          ctx.fillStyle = '#5DADE2';

          ctx.font = 'bold 14px sans-serif';

          ctx.fillText('\u2191', bx + 3, y + 20); // up arrow

        }

        if (eInThisOrbital >= 2) {

          ctx.fillStyle = '#E74C3C';

          ctx.fillText('\u2193', bx + 12, y + 20); // down arrow

        }

      }



      x += numOrbitals * (boxW + gap) + groupGap;

      if (x > canvas.width - 60) { x = 15; y += 55; }

    });

