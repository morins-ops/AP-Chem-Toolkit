  draw(conc, path, eps, color, A, T_pct) {

    const c = document.getElementById('u3d-canvas');

    const ctx = c.getContext('2d');

    const W = c.width, H = c.height;

    ctx.clearRect(0,0,W,H);



    const ci = this.colorMap[color];



    // ===== TOP: Cuvette diagram =====

    const cuvetteH = 160;

    const cuvetteY = 20;



    // Light source

    ctx.fillStyle = '#fff'; ctx.font = 'bold 11px Roboto'; ctx.textAlign = 'center';

    ctx.fillText('Beer-Lambert Law Visualization', W/2, 15);



    // Arrow (incident light)

    const arrowY = cuvetteY + cuvetteH/2;

    ctx.strokeStyle = '#ffff00'; ctx.lineWidth = 3;

    ctx.beginPath(); ctx.moveTo(30, arrowY); ctx.lineTo(130, arrowY); ctx.stroke();

    ctx.beginPath(); ctx.moveTo(120, arrowY-8); ctx.lineTo(130, arrowY); ctx.lineTo(120, arrowY+8); ctx.fill();

    ctx.fillStyle = '#ffff00'; ctx.font = '10px Roboto';

    ctx.fillText('I₀', 80, arrowY - 15);

    ctx.fillText('(white light)', 80, arrowY + 20);



    // Cuvette

    const cuvX = 140, cuvW = Math.max(40, path * 50), cuvH = 100;

    const cuvY = cuvetteY + (cuvetteH - cuvH)/2;



    // Solution fill with opacity based on concentration

    const opacity = Math.min(0.95, conc * 3);

    ctx.fillStyle = `rgba(${ci.rgb}, ${opacity})`;

    ctx.fillRect(cuvX, cuvY, cuvW, cuvH);



    // Cuvette outline

    ctx.strokeStyle = '#aaa'; ctx.lineWidth = 2;

    ctx.strokeRect(cuvX, cuvY, cuvW, cuvH);



    // Path length label

    ctx.fillStyle = _tc('#ddd','#333'); ctx.font = '9px Roboto'; ctx.textAlign = 'center';

    ctx.fillText(`b = ${path.toFixed(1)} cm`, cuvX + cuvW/2, cuvY + cuvH + 15);



    // Transmitted light (dimmer)

    const transAlpha = T_pct / 100;

    ctx.strokeStyle = `rgba(255,255,0,${Math.max(0.1, transAlpha)})`;

    ctx.lineWidth = 3 * transAlpha;

    const afterCuv = cuvX + cuvW;

    ctx.beginPath(); ctx.moveTo(afterCuv, arrowY); ctx.lineTo(afterCuv + 80, arrowY); ctx.stroke();

    ctx.fillStyle = `rgba(255,255,0,${Math.max(0.2, transAlpha)})`;

    ctx.font = '10px Roboto';

    ctx.fillText('I', afterCuv + 40, arrowY - 15);

    ctx.fillText(`(${T_pct.toFixed(1)}%)`, afterCuv + 40, arrowY + 20);



    // Detector

    ctx.fillStyle = '#555';

    ctx.fillRect(afterCuv + 80, arrowY - 20, 30, 40);

    ctx.fillStyle = _tc('#aaa','#666'); ctx.font = '8px Roboto';

    ctx.fillText('Detector', afterCuv + 95, arrowY + 30);



    // Solution dots (particles)

    const numDots = Math.round(conc * 80);

    for (let i = 0; i < numDots; i++) {

      const dx = cuvX + 5 + Math.random() * (cuvW - 10);

      const dy = cuvY + 5 + Math.random() * (cuvH - 10);

      ctx.beginPath(); ctx.arc(dx, dy, 2, 0, Math.PI*2);

      ctx.fillStyle = `rgba(${ci.rgb}, 0.8)`;

      ctx.fill();

    }



    // ===== BOTTOM: Absorbance vs Concentration graph =====

    const graphY = cuvetteH + 55;

    const gPad = {l:60, r:20, t:graphY, b:H-30};

    const gW = W - gPad.l - gPad.r;

    const gH = gPad.b - gPad.t;



    // Graph background

    ctx.fillStyle = '#111'; ctx.fillRect(gPad.l, gPad.t, gW, gH);



    // Grid

    ctx.strokeStyle = '#2a2a2a'; ctx.lineWidth = 0.5;

    for (let i = 1; i <= 4; i++) {

      const y = gPad.t + gH - (i/4)*gH;

      ctx.beginPath(); ctx.moveTo(gPad.l, y); ctx.lineTo(gPad.l+gW, y); ctx.stroke();

    }



    // Beer-Lambert line (A = εbc, with b and ε fixed, varying c)

    const maxC = 0.5;

    const maxA = eps * path * maxC;

    const yScale = Math.max(maxA, 2);



    ctx.beginPath();

    ctx.strokeStyle = _tg(); ctx.lineWidth = 2;

    for (let c2 = 0; c2 <= maxC; c2 += 0.005) {

      const a2 = eps * path * c2;

      const x = gPad.l + (c2/maxC)*gW;

      const y = gPad.t + gH - (a2/yScale)*gH;

      if (c2 === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);

    }

    ctx.stroke();



    // Current point

    const ptX = gPad.l + (conc/maxC)*gW;

    const ptY = gPad.t + gH - (A/yScale)*gH;

    ctx.beginPath(); ctx.arc(ptX, ptY, 6, 0, Math.PI*2);

    ctx.fillStyle = '#E74C3C'; ctx.fill();

    ctx.strokeStyle = '#fff'; ctx.lineWidth = 2; ctx.stroke();



    // Dashed lines to point

    ctx.setLineDash([3,3]); ctx.strokeStyle = '#888'; ctx.lineWidth = 1;

    ctx.beginPath(); ctx.moveTo(ptX, gPad.t+gH); ctx.lineTo(ptX, ptY); ctx.stroke();

    ctx.beginPath(); ctx.moveTo(gPad.l, ptY); ctx.lineTo(ptX, ptY); ctx.stroke();

    ctx.setLineDash([]);



    // Point label

    ctx.fillStyle = '#fff'; ctx.font = '10px Roboto'; ctx.textAlign = 'left';

    ctx.fillText(`A = ${A.toFixed(3)}`, ptX + 10, ptY - 5);



    // Axes

    ctx.strokeStyle = '#aaa'; ctx.lineWidth = 1;

    ctx.beginPath(); ctx.moveTo(gPad.l, gPad.t); ctx.lineTo(gPad.l, gPad.t+gH); ctx.lineTo(gPad.l+gW, gPad.t+gH); ctx.stroke();



    // X axis labels

    ctx.fillStyle = _tc('#aaa','#666'); ctx.font = '10px Roboto'; ctx.textAlign = 'center';

    for (let c2 = 0; c2 <= maxC; c2 += 0.1) {

      const x = gPad.l + (c2/maxC)*gW;

      ctx.fillText(c2.toFixed(1), x, gPad.t+gH+13);

    }

    ctx.fillText('Concentration (M)', gPad.l + gW/2, H-5);



    // Y axis labels

    ctx.textAlign = 'right';

    for (let a2 = 0; a2 <= yScale; a2 += Math.ceil(yScale/4)) {

      const y = gPad.t + gH - (a2/yScale)*gH;

      ctx.fillText(a2.toFixed(1), gPad.l-8, y+4);

    }

    ctx.save(); ctx.translate(12, gPad.t+gH/2); ctx.rotate(-Math.PI/2);

    ctx.textAlign = 'center'; ctx.fillText('Absorbance', 0, 0); ctx.restore();

  },

  init() { this.update(); }

};



